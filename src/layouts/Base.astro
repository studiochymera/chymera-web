---
import '../styles/global.css';
import site from '../data/site.json';
import { raiz } from '../lib/rutas';

interface Props {
  titulo?: string;
  descripcion?: string;
  schemaExtra?: object;
  noIndexar?: boolean;
}

const {
  titulo = `${site.nombre} · Páginas web para negocios en ${site.ciudad}`,
  descripcion = site.hero.subtitulo,
  schemaExtra,
  noIndexar = false,
} = Astro.props;

const r = raiz(Astro.url.pathname);

const canonica = new URL(Astro.url.pathname, Astro.site).href;
const imagenSocial = new URL('og.jpg', Astro.site).href;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  '@id': `${Astro.site?.href}#negocio`,
  name: site.nombre,
  url: Astro.site?.href,
  email: site.correo,
  telephone: `+${site.whatsapp}`,
  image: imagenSocial,
  sameAs: [`https://www.instagram.com/${site.instagram}/`],
  areaServed: site.ciudad,
  address: { '@type': 'PostalAddress', addressLocality: site.ciudad, addressCountry: 'CO' },
};
---

<!doctype html>
<html lang="es-CO">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titulo}</title>
    <meta name="description" content={descripcion} />
    <meta name="theme-color" content="#1D2A3A" />
    <link rel="icon" type="image/png" href={`${r}favicon.png`} />
    <link rel="apple-touch-icon" href={`${r}apple-touch-icon.png`} />
    <link rel="canonical" href={canonica} />
    {noIndexar && <meta name="robots" content="noindex, follow" />}
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonica} />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:image" content={imagenSocial} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="es_CO" />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    {schemaExtra && <script type="application/ld+json" set:html={JSON.stringify(schemaExtra)} />}
  </head>
  <body>
    <slot />
  </body>
</html>
