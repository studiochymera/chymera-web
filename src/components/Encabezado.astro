---
import site from '../data/site.json';
import { raiz, enlaceWhatsApp } from '../lib/rutas';

const r = raiz(Astro.url.pathname);
const enInicio = r === './';
// En la portada los enlaces son anclas; en otras páginas vuelven a la portada.
const pre = enInicio ? '' : r;
const wa = enlaceWhatsApp(site.whatsapp, site.whatsappTexto);
const nav = [
  { href: `${pre}#servicios`, texto: 'Servicios' },
  { href: `${pre}#portafolio`, texto: 'Portafolio' },
  { href: `${pre}#precios`, texto: 'Precios' },
  { href: `${pre}#proceso`, texto: 'Proceso' },
  { href: `${pre}#preguntas`, texto: 'Preguntas' },
];
---

<header class="encabezado">
  <div class="contenedor encabezado-fila">
    <a href={enInicio ? '#inicio' : r} class="encabezado-logo" aria-label={`${site.nombre}, inicio`}>
      <img src={`${r}brand/chymera-logo-medianoche.svg`} alt={site.nombre} width="226" height="43" />
    </a>
    <nav class="encabezado-nav" aria-label="Principal">
      {nav.map((n) => <a href={n.href}>{n.texto}</a>)}
    </nav>
    <a href={wa} class="boton-maiz encabezado-boton" target="_blank" rel="noopener">Escríbenos</a>
  </div>
</header>

<style>
  .encabezado {
    position: sticky;
    top: 0;
    z-index: 40;
    background: var(--color-papel);
    border-bottom: 1px solid color-mix(in oklab, var(--color-medianoche) 10%, transparent);
  }
  .encabezado-fila {
    display: flex;
    height: 4rem;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }
  .encabezado-logo img {
    display: block;
    height: 1.6rem;
    width: auto;
  }
  .encabezado-nav {
    display: none;
    gap: 1.75rem;
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--color-medianoche);
  }
  .encabezado-nav a {
    position: relative;
    padding-block: 0.5rem;
  }
  .encabezado-nav a::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0.25rem;
    height: 2px;
    background: var(--color-maiz);
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 220ms cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .encabezado-nav a:hover::after {
    transform: scaleX(1);
    transform-origin: left;
  }
  @media (min-width: 900px) {
    .encabezado-nav {
      display: flex;
    }
  }
  .encabezado-boton {
    min-height: 2.75rem;
    padding-inline: 1.125rem;
  }
</style>
