---
// Mesa de piezas: dibuja en SVG la composición inicial (se ve sin JavaScript y sin esperar nada)
// y deja el lugar donde src/scripts/mesa.ts pone el lienzo animado encima.
import { estado, trazo, COLORES, portadaSuelta, RECORRIDO, type Entrada } from '../lib/piezas';

interface Props {
  tipo: 'portada' | 'recorrido';
  etiqueta: string;
  fondo?: 'claro' | 'oscuro';
  inicial?: string; // composición del recorrido
  boton?: { armar: string; desarmar: string };
  class?: string;
}

const { tipo, etiqueta, fondo = 'claro', inicial = 'marca', boton, class: clase } = Astro.props;
const comp: Entrada[] = tipo === 'portada' ? portadaSuelta() : RECORRIDO[inicial];
const piezas = comp.map((e) => ({ d: trazo(estado(e)), fill: COLORES[e[5]] }));
---

<div class:list={['mesa', clase]} data-mesa={tipo} data-fondo={fondo}>
  <div class="mesa-escena">
    <svg class="mesa-svg" viewBox="0 0 12 12" role="img" aria-label={etiqueta}>
      {piezas.map((p) => <path d={p.d} fill={p.fill} />)}
    </svg>
  </div>
  {boton && (
    <div class="mesa-pie">
    <slot />
    <button type="button" class="mesa-boton" data-mesa-boton data-armar={boton.armar} data-desarmar={boton.desarmar} aria-pressed="true">
      {boton.armar}
    </button>
    </div>
  )}
</div>

<style>
  .mesa {
    position: relative;
  }
  .mesa-escena {
    position: relative;
    aspect-ratio: 1;
    width: 100%;
    max-width: 100%;
    touch-action: pan-y;
  }
  .mesa-svg,
  .mesa-escena :global(.mesa-lienzo) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }
  .mesa-svg path {
    filter: drop-shadow(0.1px 0.12px 0 rgb(14 20 36 / 0.1));
  }
  :global(.mesa-viva) .mesa-svg {
    visibility: hidden;
  }
  .mesa-pie {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 1rem;
  }
  .mesa-boton {
    margin-left: auto;
    flex: none;
    min-height: 44px;
    padding: 0 1rem;
    border-radius: 999px;
    border: 1.5px solid currentColor;
    background: transparent;
    font: 600 0.875rem/1 var(--font-sans);
    color: inherit;
    cursor: pointer;
    transition: background-color 160ms cubic-bezier(0.2, 0.7, 0.2, 1), color 160ms cubic-bezier(0.2, 0.7, 0.2, 1), transform 160ms cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .mesa-boton:hover {
    background: var(--color-medianoche);
    color: var(--color-papel);
  }
  .mesa-boton:active {
    transform: scale(0.97);
  }
</style>
