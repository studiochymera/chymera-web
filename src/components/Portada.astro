---
// Portada de Chymera: una sala clara con una sola pieza en 3D, tres páginas web flotando en
// abanico (dos de vidrio esmerilado y una de cerámica azul con el botón celeste).
// Primero se ve una foto de las pantallas (la misma pose y la misma luz); cuando el 3D carga, la
// reemplaza sin salto, flotan, siguen al mouse y se giran un poco arrastrando. Si no hay WebGL,
// queda la foto.
// El titular y los botones se ven sin esperar ninguna animación.
import site from '../data/site.json';
import { enlaceWhatsApp } from '../lib/rutas';
import Imagen from '../base/Imagen.astro';

const h = site.hero;
const c = h.cartela;
---

<section class="portada" aria-labelledby="portada-titulo">
  <div class="contenedor portada-reticula">
    <div class="portada-texto">
      <p class="portada-etiqueta">{h.etiqueta}</p>
      <h1 id="portada-titulo" class="portada-titulo">
        {h.titulo.split(' ').map((palabra, i) => <><span class="palabra" style={`--i:${i}`}>{palabra}</span>{' '}</>)}
      </h1>
      <p class="portada-sub">{h.subtitulo}</p>
      <div class="portada-botones">
        <a href={enlaceWhatsApp(site.whatsapp, site.whatsappTexto)} class="boton-azul" target="_blank" rel="noopener">{h.boton}</a>
        <a href="#portafolio" class="boton-linea">{h.botonDemos}</a>
      </div>
      <p class="portada-kit">
        {h.kit} <a href="portafolio/kit-de-marca/">{h.kitEnlace}</a>
      </p>
    </div>

    <figure class="sala" data-sala>
      <div class="sala-escena" data-sala-escena aria-hidden="true">
        <Imagen
          ruta="marca/pantallas"
          alt=""
          anchos={[560, 840, 1120, 1400]}
          sizes="(min-width: 1024px) 760px, 115vw"
          proporcion="1400/1064"
          prioridad
          claseMarco="sala-foto"
          class="block h-full w-full"
        />
      </div>
      <figcaption class="cartela">
        <span class="cartela-titulo">{c.titulo}</span>
        <span class="cartela-detalle">{c.detalle}</span>
        <span class="cartela-gesto" aria-hidden="true">{c.gesto}</span>
      </figcaption>
    </figure>
  </div>
</section>

<style>
  .portada {
    --tras-intro: 1.3s;
    --salida: cubic-bezier(0.22, 1, 0.36, 1);
    position: relative;
    overflow: hidden;
    background: var(--color-crema);
    isolation: isolate;
  }

  .portada-reticula {
    display: grid;
    padding-block: 1.5rem 3rem;
  }
  @media (min-width: 1024px) {
    .portada-reticula {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      align-items: center;
      min-height: min(52rem, calc(100svh - 4rem));
      padding-block: 3rem;
    }
    .portada-texto {
      position: relative;
      z-index: 1;
      grid-column: 1 / span 6;
      grid-row: 1;
    }
  }

  .portada-etiqueta {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    font-size: 0.875rem;
    font-weight: 500;
    color: rgb(4 5 7 / 0.7);
  }
  .portada-etiqueta::before {
    content: '';
    width: 1.75rem;
    height: 1px;
    background: var(--color-azul);
  }

  .portada-titulo {
    margin-top: 1.25rem;
    font-size: clamp(2.6rem, 1.6rem + 4.6vw, 5.25rem);
    font-weight: 600;
    line-height: 1.02;
    letter-spacing: -0.04em;
  }

  .portada-sub {
    max-width: 33rem;
    margin-top: 1.5rem;
    font-size: 1.0625rem;
    line-height: 1.6;
    color: rgb(4 5 7 / 0.75);
    text-wrap: pretty;
  }
  @media (min-width: 640px) {
    .portada-sub {
      font-size: 1.125rem;
    }
  }

  .portada-botones {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }
  .boton-linea {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    justify-content: center;
    padding: 0.75rem 1.5rem;
    border: 1px solid rgb(29 42 58 / 0.3);
    border-radius: 999px;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-azul);
    transition:
      border-color 160ms cubic-bezier(0.2, 0.7, 0.2, 1),
      background-color 160ms cubic-bezier(0.2, 0.7, 0.2, 1),
      color 160ms cubic-bezier(0.2, 0.7, 0.2, 1),
      transform 160ms cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .boton-linea:hover {
    border-color: var(--color-azul);
    background: var(--color-azul);
    color: var(--color-crema);
  }
  .boton-linea:active {
    transform: scale(0.98);
  }

  .portada-kit {
    max-width: 33rem;
    margin-top: 1.75rem;
    padding-top: 1.25rem;
    border-top: 1px solid rgb(29 42 58 / 0.12);
    font-size: 0.9375rem;
    color: rgb(4 5 7 / 0.72);
  }
  .portada-kit a {
    color: var(--color-azul);
    font-weight: 600;
    text-decoration: underline;
    text-decoration-color: var(--color-celeste);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.3em;
  }
  .portada-kit a:hover {
    text-decoration-thickness: 2px;
  }

  /* La sala: la pieza y su cartela. La escena es más ancha que la pieza para que no se corte al girar.
     En celular y tableta la pieza va primero, encima del titular, para que se vea al entrar. */
  .sala {
    position: relative;
    order: -1;
    width: 86%;
    margin: -0.75rem auto 1.25rem;
  }
  .sala-escena {
    position: relative;
    aspect-ratio: 1400 / 1064;
    margin: -8% -12% -14%;
    touch-action: pan-y;
  }
  .sala-escena :global(.sala-foto) {
    position: absolute;
    inset: 0;
    display: block;
    transition: opacity 0.9s var(--salida);
  }
  /* El lienzo lo crea pantallas3d.ts (por eso va con :global). Aparece sobre la foto y la foto se va. */
  .sala-escena :global(.pieza-3d) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    cursor: grab;
    transition: opacity 0.9s var(--salida);
  }
  .sala-escena :global(.pieza-3d:active) {
    cursor: grabbing;
  }
  .sala[data-estado='3d'] :global(.pieza-3d) {
    opacity: 1;
  }
  .sala[data-estado='3d'] :global(.sala-foto) {
    opacity: 0;
  }

  /* Cartela de museo: nombre de la pieza, qué es y cómo se mira. */
  .cartela {
    position: relative;
    display: grid;
    gap: 0.15rem;
    width: fit-content;
    max-width: 17rem;
    margin: -0.75rem -1rem 0 auto;
    padding-top: 0.6rem;
    border-top: 1px solid rgb(29 42 58 / 0.25);
    font-size: 0.8125rem;
    line-height: 1.45;
    color: rgb(4 5 7 / 0.72);
  }
  .cartela-titulo {
    font-family: var(--font-display);
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--color-azul);
  }
  .cartela-detalle {
    display: none;
  }
  .cartela-gesto {
    font-size: 0.75rem;
    color: rgb(4 5 7 / 0.6);
    opacity: 0;
    transition: opacity 0.6s var(--salida) 0.6s;
  }
  .sala[data-estado='3d'] .cartela-gesto {
    opacity: 1;
  }

  @media (min-width: 640px) {
    .sala {
      width: min(100%, 30rem);
      margin-bottom: 2rem;
    }
    .cartela {
      margin-right: 0;
    }
    .cartela-detalle {
      display: block;
    }
    .cartela-gesto {
      margin-top: 0.35rem;
    }
  }
  @media (min-width: 1024px) {
    .sala {
      order: 0;
      width: auto;
      grid-column: 7 / span 6;
      grid-row: 1;
      margin: 0 -6% 0 0;
    }
    .sala-escena {
      margin: 0 0 -6% 0;
    }
    .cartela {
      margin-top: 0;
      margin-right: 12%;
    }
  }

  /* Movimiento: solo si la persona no pidió reducirlo. */
  @media (prefers-reduced-motion: no-preference) {
    /* Titular: las palabras suben en cascada mientras la cortina de la intro se va. */
    .palabra {
      display: inline-block;
      animation: palabra 1s var(--salida) backwards;
      animation-delay: calc(var(--tras-intro) - 0.2s + var(--i) * 55ms);
    }
    .portada-etiqueta,
    .portada-botones,
    .portada-kit,
    .cartela {
      animation: aparecer 0.9s var(--salida) backwards;
    }
    /* El subtítulo y la foto de la pieza son lo más grande que pinta la portada: solo se mueven,
       sin pasar por invisibles, para no atrasar la carga que mide Google. */
    .portada-sub {
      animation: subir 0.9s var(--salida) backwards;
    }
    .sala-escena {
      animation: posar 1.4s var(--salida) backwards;
      animation-delay: calc(var(--tras-intro) - 0.1s);
    }
    .portada-etiqueta {
      animation-delay: calc(var(--tras-intro) - 0.1s);
    }
    .portada-sub {
      animation-delay: calc(var(--tras-intro) + 0.25s);
    }
    .portada-botones {
      animation-delay: calc(var(--tras-intro) + 0.35s);
    }
    .portada-kit {
      animation-delay: calc(var(--tras-intro) + 0.45s);
    }
    .cartela {
      animation-delay: calc(var(--tras-intro) + 0.7s);
    }
  }

  :global(html.sin-intro) .portada {
    --tras-intro: 0s;
  }
  @keyframes palabra {
    from {
      transform: translateY(0.45em) rotate(2deg);
    }
  }
  @keyframes aparecer {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
  }
  @keyframes subir {
    from {
      transform: translateY(16px);
    }
  }
  @keyframes posar {
    from {
      transform: translateY(24px) scale(0.97);
    }
  }
</style>
