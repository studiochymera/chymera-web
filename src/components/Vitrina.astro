---
// Vitrina: las tres demos en un celular, justo después de la portada.
// El celular se "construye" desde su plano cuando llega a la pantalla y luego pasa solo de una demo
// a otra (con pausa), o con las pestañas.
import site from '../data/site.json';
import Imagen from '../base/Imagen.astro';

const v = site.vitrina;
const demos = site.demos.lista.map((d) => ({ d, plan: site.paquetes.find((p) => p.slug === d.plan)! }));
const ver = (nombre: string) => v.ver.replace('{nombre}', nombre);
---

<section class="vitrina-seccion" aria-labelledby="vitrina-titulo">
  <div class="contenedor vitrina-reticula">
    <div class="vitrina-texto">
      <h2 id="vitrina-titulo" class="vitrina-h2">{v.titulo}</h2>
      <p class="vitrina-p">{v.texto}</p>
      <a href="#portafolio" class="enlace-vitrina">{v.enlace}</a>
    </div>

    <div class="vitrina" data-vitrina data-inclinar>
      <div class="celular-3d" data-inclinar-objeto>
        <a href={`demos/${demos[0].d.slug}/`} class="celular" data-vitrina-enlace aria-label={ver(demos[0].d.nombre)}>
          <span class="celular-pantalla">
            <span class="plano" aria-hidden="true">
              <span style="--i:0" class="plano-barra"></span>
              <span style="--i:1" class="plano-titulo"></span>
              <span style="--i:2" class="plano-titulo plano-corto"></span>
              <span style="--i:3" class="plano-texto"></span>
              <span style="--i:4" class="plano-boton"></span>
              <span style="--i:5" class="plano-foto"></span>
            </span>
            {demos.map(({ d }, i) => (
              <span class="pantalla" data-pantalla={i} data-activa={i === 0 ? '' : undefined}>
                <Imagen
                  ruta={`portafolio/${d.slug}`}
                  alt=""
                  anchos={[320, 480, 640]}
                  sizes="(min-width: 1024px) 290px, 62vw"
                  proporcion="390/700"
                  claseMarco="block h-full"
                  class="h-full w-full object-cover object-top"
                />
              </span>
            ))}
          </span>
          <span class="brillo" aria-hidden="true"></span>
        </a>
      </div>

      <div class="vitrina-pie">
        <div class="pestanas" role="group" aria-label={v.etiqueta}>
          {demos.map(({ d, plan }, i) => (
            <button type="button" class="pestana" data-pestana={i} data-nombre={d.nombre} data-slug={d.slug} aria-label={`${d.nombre}, plan ${plan.nombre}`} aria-pressed={i === 0 ? 'true' : 'false'}>
              <span class="pestana-nombre">{d.nombre.split(' ')[0]}</span>
              <span class="pestana-plan">{plan.nombre}</span>
              <span class="pestana-avance" aria-hidden="true"></span>
            </button>
          ))}
          <button type="button" class="pausa" data-pausa data-pausar={v.pausar} data-reanudar={v.reanudar} aria-pressed="false">
            <span class="pausa-icono" aria-hidden="true"></span>
            <span class="sr-only" data-pausa-texto>{v.pausar}</span>
          </button>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  // Vitrina: pasa sola de una demo a otra (con pausa), o con las pestañas.
  const vitrina = document.querySelector<HTMLElement>('[data-vitrina]');
  if (vitrina) {
    const pantallas = [...vitrina.querySelectorAll<HTMLElement>('[data-pantalla]')];
    const pestanas = [...vitrina.querySelectorAll<HTMLButtonElement>('[data-pestana]')];
    const enlace = vitrina.querySelector<HTMLAnchorElement>('[data-vitrina-enlace]')!;
    const pausa = vitrina.querySelector<HTMLButtonElement>('[data-pausa]')!;
    const pausaTexto = pausa.querySelector('[data-pausa-texto]')!;
    const nombres = pestanas.map((p) => p.dataset.nombre!);
    const plantilla = enlace.getAttribute('aria-label')!.replace(nombres[0], '{nombre}');
    let actual = 0;

    // El celular se construye y empieza a pasar demos cuando llega a la pantalla.
    new IntersectionObserver(
      ([e], vigia) => {
        if (!e.isIntersecting) return;
        vitrina.dataset.visible = '';
        vigia.disconnect();
      },
      { threshold: 0.35 },
    ).observe(vitrina);

    const mostrar = (i: number) => {
      if (i === actual) return;
      vitrina.classList.add('iniciada');
      pantallas.forEach((p) => p.removeAttribute('data-previa'));
      pantallas[actual].removeAttribute('data-activa');
      pantallas[actual].setAttribute('data-previa', '');
      pantallas[i].setAttribute('data-activa', '');
      pestanas.forEach((p, j) => p.setAttribute('aria-pressed', String(j === i)));
      enlace.setAttribute('href', `demos/${pestanas[i].dataset.slug}/`);
      enlace.setAttribute('aria-label', plantilla.replace('{nombre}', nombres[i]));
      actual = i;
    };

    pestanas.forEach((p, i) => {
      p.addEventListener('click', () => {
        vitrina.dataset.visible = '';
        mostrar(i);
      });
      p.querySelector('.pestana-avance')!.addEventListener('animationend', () => mostrar((i + 1) % pantallas.length));
    });

    pausa.addEventListener('click', () => {
      const pausado = vitrina.classList.toggle('en-pausa');
      pausa.setAttribute('aria-pressed', String(pausado));
      pausaTexto.textContent = pausado ? pausa.dataset.reanudar! : pausa.dataset.pausar!;
    });
  }
</script>

<style>
  .vitrina-seccion {
    --salida: cubic-bezier(0.22, 1, 0.36, 1);
    --mover: cubic-bezier(0.65, 0, 0.35, 1);
    background: var(--color-azul);
    color: var(--color-crema);
  }
  .vitrina-reticula {
    display: grid;
    gap: 3rem;
    padding-block: clamp(4rem, 2.5rem + 5vw, 7rem);
  }
  @media (min-width: 1024px) {
    .vitrina-reticula {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      align-items: center;
      gap: 4rem;
    }
  }

  .vitrina-h2 {
    color: var(--color-crema);
    font-size: clamp(2rem, 1.4rem + 2.6vw, 3.25rem);
    font-weight: 600;
    line-height: 1.06;
    letter-spacing: -0.035em;
  }
  .vitrina-p {
    max-width: 30rem;
    margin-top: 1.25rem;
    color: rgb(253 248 244 / 0.78);
    text-wrap: pretty;
  }
  .enlace-vitrina {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    margin-top: 1.25rem;
    font-weight: 600;
    color: var(--color-crema);
    text-decoration: underline;
    text-decoration-color: var(--color-celeste);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.3em;
    transition: color 150ms ease;
  }
  .enlace-vitrina:hover {
    color: var(--color-celeste);
  }

  .vitrina {
    display: grid;
    justify-items: center;
    gap: 1.75rem;
  }

  .celular-3d {
    position: relative;
  }
  .celular {
    position: relative;
    display: block;
    width: min(62vw, 18rem);
    aspect-ratio: 288 / 504;
    padding: 0.55rem;
    border-radius: 2.6rem;
    background: #0b1119;
    box-shadow:
      0 0 0 1px rgb(253 248 244 / 0.14),
      0 2px 4px rgb(0 0 0 / 0.2),
      0 30px 60px -20px rgb(0 0 0 / 0.6);
  }
  .celular::before {
    content: '';
    position: absolute;
    z-index: 5;
    top: 1.05rem;
    left: 50%;
    width: 28%;
    height: 0.85rem;
    translate: -50% 0;
    border-radius: 999px;
    background: #0b1119;
  }
  .celular:focus-visible {
    outline: 2px solid var(--color-celeste);
    outline-offset: 6px;
  }

  /* Falso 3D: movimiento.ts inclina el celular hacia el mouse y mueve el brillo. */
  .brillo {
    position: absolute;
    inset: 0.55rem;
    z-index: 6;
    border-radius: 2.05rem;
    background: radial-gradient(circle at var(--brillo-x, 50%) var(--brillo-y, 0%), rgb(255 255 255 / 0.22), transparent 55%);
    opacity: 0;
    pointer-events: none;
    transition: opacity 300ms ease;
  }
  @media (hover: hover) and (pointer: fine) {
    :global(html.con-movimiento) .vitrina:hover .brillo {
      opacity: 1;
    }
  }

  .celular-pantalla {
    position: relative;
    display: block;
    height: 100%;
    overflow: hidden;
    border-radius: 2.05rem;
    background: #152030;
  }

  /* El plano: la página antes del diseño. */
  .plano {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
    padding: 2.6rem 1.1rem 1.1rem;
  }
  .plano > span {
    display: block;
    border: 1px dashed rgb(39 155 242 / 0.55);
    border-radius: 3px;
    transform-origin: left;
  }
  .plano-barra {
    height: 1.4rem;
    margin-bottom: 1.2rem;
  }
  .plano-titulo {
    height: 1.9rem;
  }
  .plano-corto {
    width: 62%;
  }
  .plano-texto {
    height: 3rem;
    width: 88%;
  }
  .plano-boton {
    height: 2.2rem;
    width: 55%;
    border-radius: 999px !important;
  }
  .plano-foto {
    flex: 1;
    margin-top: 0.6rem;
  }

  .pantalla {
    position: absolute;
    inset: 0;
    clip-path: inset(0 0 100% 0);
    transition: clip-path 900ms var(--mover);
  }
  .pantalla[data-activa] {
    z-index: 2;
    clip-path: inset(0);
  }
  .pantalla[data-previa] {
    z-index: 1;
    clip-path: inset(0);
    transition: none;
  }

  .vitrina-pie {
    width: min(100%, 26rem);
  }
  .pestanas {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr)) auto;
    gap: 0.25rem;
  }
  .pestana {
    position: relative;
    display: grid;
    min-height: 2.75rem;
    padding: 0.5rem 0.5rem 0.75rem;
    border: 0;
    border-radius: 0.5rem;
    background: transparent;
    color: rgb(253 248 244 / 0.72);
    text-align: left;
    cursor: pointer;
    transition: color 150ms ease, background-color 150ms ease;
  }
  .pestana:hover,
  .pestana[aria-pressed='true'] {
    color: var(--color-crema);
  }
  .pestana:focus-visible,
  .pausa:focus-visible {
    outline: 2px solid var(--color-celeste);
    outline-offset: 2px;
  }
  .pestana-nombre {
    font-size: 0.8125rem;
    font-weight: 600;
    line-height: 1.25;
  }
  .pestana-plan {
    font-size: 0.75rem;
    white-space: nowrap;
  }
  .pestana::before,
  .pestana-avance {
    content: '';
    position: absolute;
    left: 0.5rem;
    right: 0.5rem;
    bottom: 0.25rem;
    height: 2px;
    border-radius: 2px;
  }
  .pestana::before {
    background: rgb(253 248 244 / 0.15);
  }
  .pestana-avance {
    background: var(--color-celeste);
    transform: scaleX(0);
    transform-origin: left;
  }
  .pestana[aria-pressed='true'] .pestana-avance {
    transform: scaleX(1);
  }

  .pausa {
    display: grid;
    place-items: center;
    width: 2.75rem;
    min-height: 2.75rem;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: rgb(253 248 244 / 0.75);
    cursor: pointer;
    transition: color 150ms ease;
  }
  .pausa:hover {
    color: var(--color-crema);
  }
  .pausa-icono {
    width: 0.7rem;
    height: 0.8rem;
    border-inline: 3px solid currentColor;
  }
  .pausa[aria-pressed='true'] .pausa-icono {
    width: 0;
    height: 0;
    border-block: 0.45rem solid transparent;
    border-inline: 0.75rem solid currentColor;
    border-inline-end-width: 0;
    translate: 2px 0;
  }

  @media (min-width: 1024px) {
    .celular {
      width: 18rem;
    }
  }

  /* Movimiento: solo si la persona no pidió reducirlo, y desde que el celular se ve.
     Antes de eso todo está quieto y visible. */
  @media (prefers-reduced-motion: no-preference) {
    .vitrina[data-visible] .celular {
      animation: llegar 900ms var(--salida) backwards;
    }
    .vitrina[data-visible] .plano > span {
      animation: dibujar 500ms var(--salida) both;
      animation-delay: calc(0.35s + var(--i) * 80ms);
    }
    .vitrina[data-visible]:not(.iniciada) .pantalla[data-pantalla='0'] {
      animation: construir 1.1s var(--mover) 1.15s both;
    }

    .vitrina[data-visible] .pestana[aria-pressed='true'] .pestana-avance {
      transform: scaleX(0);
      animation: avanzar 7s linear forwards;
    }
    .vitrina[data-visible]:not(.iniciada) .pestana[data-pestana='0'] .pestana-avance {
      animation-delay: 2.25s;
    }
    .vitrina.en-pausa .pestana-avance,
    .vitrina:focus-within .pestana-avance {
      animation-play-state: paused;
    }
    @media (hover: hover) and (pointer: fine) {
      .vitrina:hover .pestana-avance {
        animation-play-state: paused;
      }
    }
  }

  /* Sin animación no hay avance automático: la pausa sobra. */
  @media (prefers-reduced-motion: reduce) {
    .pausa {
      display: none;
    }
    .pestanas {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    .pantalla {
      transition: none;
    }
  }

  @keyframes llegar {
    from {
      opacity: 0;
      transform: translateY(28px) scale(0.97);
    }
  }
  @keyframes dibujar {
    from {
      opacity: 0;
      transform: scaleX(0.2);
    }
  }
  @keyframes construir {
    from {
      clip-path: inset(0 0 100% 0);
    }
    to {
      clip-path: inset(0);
    }
  }
  @keyframes avanzar {
    from {
      transform: scaleX(0);
    }
    to {
      transform: scaleX(1);
    }
  }
</style>
