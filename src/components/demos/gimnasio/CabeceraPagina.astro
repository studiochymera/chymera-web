---
// Cabecera de las páginas internas: rótulo, H1 enorme en itálica y foto opcional con bloque voltio.
import Imagen from '../../../base/Imagen.astro';

interface Props {
  etiqueta: string;
  lineas: string[];
  entrada: string;
  incluye: string;
  foto?: string;
  alt?: string;
  pequena?: boolean;
}

const { etiqueta, lineas, entrada, incluye, foto, alt = '', pequena = false } = Astro.props;
---

<section class="oscuro relative pb-[calc(var(--corte)+3rem)] pt-10 sm:pt-14 lg:pb-[calc(var(--corte)+4.5rem)] lg:pt-20">
  <div class="contenedor grid grid-cols-1 gap-12 lg:grid-cols-12 lg:items-end lg:gap-10" data-incluye={incluye}>
    <div class:list={[foto ? 'lg:col-span-7' : 'lg:col-span-11']}>
      <p class="etiqueta entra">{etiqueta}</p>
      <h1 class:list={['mt-5 leading-[0.86]', pequena ? 'text-[clamp(2.6rem,11vw,6rem)]' : foto ? 'text-[clamp(3.1rem,14.5vw,8.75rem)] lg:text-[clamp(4.5rem,7.4vw,6.75rem)]' : 'text-[clamp(3.1rem,14.5vw,8.75rem)]']}>
        {lineas.map((l, i) => (
          <>
            <span class:list={['entra block', i === 1 && 'text-voltio']} style={`--i:${i + 1}`}>{l}</span>{' '}
          </>
        ))}
      </h1>
      <p class="entra mt-7 max-w-xl text-lg text-tiza/85 lg:text-xl" style={`--i:${lineas.length + 1}`}>{entrada}</p>
      <slot />
    </div>
    {foto && (
      <div class="entra relative mr-3 lg:col-span-5 lg:mr-4" style="--i:3">
        <div class="absolute -bottom-3 -right-3 h-full w-full bg-voltio lg:-bottom-4 lg:-right-4" aria-hidden="true"></div>
        <div class="relative aspect-[4/3] overflow-hidden lg:aspect-[4/5]">
          <Imagen
            ruta={`demos/gimnasio/${foto}`}
            alt={alt}
            prioridad={true}
            proporcion="4/3"
            sizes="(min-width: 1024px) 40vw, 100vw"
            anchos={[480, 800, 1100]}
            claseMarco="block h-full w-full"
            class="foto h-full w-full object-cover"
          />
        </div>
      </div>
    )}
  </div>
</section>
