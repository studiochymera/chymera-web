---
// Iconos de trazo simple para la demo Forja. Siempre decorativos (aria-hidden).
interface Props {
  nombre: 'whatsapp' | 'flecha' | 'telefono' | 'correo' | 'instagram' | 'menu' | 'cerrar' | 'mas' | 'marca';
  class?: string;
}
const { nombre, class: clase } = Astro.props;
---

{nombre === 'whatsapp' && (
  <svg class={clase} viewBox="0 0 32 32" width="22" height="22" aria-hidden="true"><path fill="currentColor" d="M16 3a13 13 0 0 0-11.2 19.6L3 29l6.6-1.7A13 13 0 1 0 16 3zm0 23.7a10.7 10.7 0 0 1-5.5-1.5l-.4-.2-3.9 1 1-3.8-.2-.4A10.7 10.7 0 1 1 16 26.7zm5.9-8c-.3-.2-1.9-.9-2.2-1s-.5-.2-.7.2-.8 1-1 1.2-.4.2-.7 0a8.8 8.8 0 0 1-4.4-3.8c-.3-.6.3-.5 1-1.7.1-.2 0-.4 0-.6l-1-2.4c-.3-.6-.5-.5-.7-.5h-.6a1.2 1.2 0 0 0-.9.4 3.7 3.7 0 0 0-1.1 2.7 6.4 6.4 0 0 0 1.3 3.4 14.7 14.7 0 0 0 5.6 5c2.1.9 2.9 1 4 .8a3.4 3.4 0 0 0 2.2-1.6 2.8 2.8 0 0 0 .2-1.6c-.1-.1-.3-.2-.6-.3z"/></svg>
)}
{nombre === 'flecha' && (
  <svg class:list={['flecha', clase]} viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="2.75" stroke-linecap="square" d="M3 12h16m-6-7 7 7-7 7"/></svg>
)}
{nombre === 'telefono' && (
  <svg class={clase} viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" d="M5 3h4l2 5-2.5 1.5a11 11 0 0 0 6 6L16 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 5a2 2 0 0 1 2-2z"/></svg>
)}
{nombre === 'correo' && (
  <svg class={clase} viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="2" d="M3 5h18v14H3zM3 6l9 7 9-7"/></svg>
)}
{nombre === 'instagram' && (
  <svg class={clase} viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5" fill="none" stroke="currentColor" stroke-width="2"/><circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="2"/><circle cx="17.5" cy="6.5" r="1.3" fill="currentColor"/></svg>
)}
{nombre === 'menu' && (
  <svg class={clase} viewBox="0 0 24 24" width="24" height="24" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="2.5" d="M4 7h16M2 12h16M4 17h16"/></svg>
)}
{nombre === 'cerrar' && (
  <svg class={clase} viewBox="0 0 24 24" width="24" height="24" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="2.5" d="m5 5 14 14M19 5 5 19"/></svg>
)}
{nombre === 'mas' && (
  <svg class={clase} viewBox="0 0 24 24" width="24" height="24" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="3" d="M12 3v18M3 12h18"/></svg>
)}
{nombre === 'marca' && (
  <svg class={clase} viewBox="0 0 64 64" width="32" height="32" aria-hidden="true"><path fill="currentColor" d="M12 56h11l9.4-44H21.4zM21.4 12H54l-1.7 8H19.7zM17.6 30H44l-1.5 7H16.1z"/></svg>
)}
