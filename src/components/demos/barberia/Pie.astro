---
// Pie de Filo: datos del negocio, horario resumido, aviso de privacidad y crédito de Chymera.
import Poste from './Poste.astro';
import { d, contacto, horario, textosBase } from './datos';
import { raiz } from '../../../base/formato';

const r = raiz(Astro.url.pathname);
const privacidad = `${r}demos/barberia/privacidad/`;
---

<footer class="bg-carbon-3 text-hueso">
  <div class="poste h-2.5" aria-hidden="true"></div>
  <div class="contenedor grid gap-10 py-14 sm:py-16 lg:grid-cols-[1.4fr_1fr_1.1fr_1fr] lg:gap-12" data-incluye={d.incluye.pie}>
    <div>
      <p class="flex items-center gap-3">
        <Poste class="h-11 w-3" animado={false} />
        <span class="font-serif text-4xl leading-none">{d.negocio.nombre}</span>
      </p>
      <p class="mt-4 max-w-xs text-hueso/70">{d.pie.lema}</p>
    </div>

    <div>
      <h2 class="etiqueta text-laton">{d.pie.tituloVisitanos}</h2>
      <p class="mt-3">{d.negocio.direccion}</p>
    </div>

    <div>
      <h2 class="etiqueta text-laton">{d.pie.tituloHorario}</h2>
      <ul class="mt-3 space-y-2">
        {horario.map((h) => (
          <li><span class="block text-sm text-hueso/70">{h.corto}</span><span class="whitespace-nowrap">{h.rango}</span></li>
        ))}
      </ul>
    </div>

    <div>
      <h2 class="etiqueta text-laton">{d.pie.tituloEscribenos}</h2>
      <ul class="mt-1">
        <li><a href={contacto.telefonoEnlace} class="enlace-subrayado inline-flex min-h-11 items-center">{contacto.telefono}</a></li>
        <li><a href={`mailto:${contacto.correo}`} class="enlace-subrayado inline-flex min-h-11 items-center break-all">{contacto.correo}</a></li>
        <li><a href={contacto.instagram} target="_blank" rel="noopener" class="enlace-subrayado inline-flex min-h-11 items-center">{d.comunes.instagram}</a></li>
      </ul>
    </div>
  </div>

  <div class="border-t border-hueso/10">
    <div class="contenedor flex flex-col gap-1 py-5 pb-24 text-sm text-hueso/70 sm:flex-row sm:items-center sm:justify-between sm:pb-5">
      <a href={privacidad} class="enlace-subrayado inline-flex min-h-11 items-center self-start text-hueso/85 sm:self-auto">{d.pie.privacidad}</a>
      <a href={r} class="enlace-subrayado inline-flex min-h-11 items-center self-start sm:self-auto">{textosBase.hechoPor}</a>
    </div>
  </div>
</footer>
