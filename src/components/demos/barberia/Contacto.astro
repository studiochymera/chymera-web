---
// Ubicación y contacto sobre hueso: horario y datos con puntos guía (mismo lenguaje de la carta) y mapa diferido.
import MapaDiferido from '../../../base/MapaDiferido.astro';
import Icono from './Icono.astro';
import { d, contacto, horario, textosBase } from './datos';

const c = d.contacto;
const filas = [
  { etiqueta: c.etiquetaDireccion, texto: d.negocio.direccion },
  { etiqueta: c.etiquetaWhatsApp, texto: c.textoWhatsApp, href: contacto.whatsapp, externo: true },
  { etiqueta: c.etiquetaTelefono, texto: contacto.telefono, href: contacto.telefonoEnlace },
  { etiqueta: c.etiquetaInstagram, texto: d.comunes.instagram, href: contacto.instagram, externo: true },
];
---

<section id="ubicacion" class="claro relative py-20 sm:py-28 lg:py-36" data-incluye={d.incluye.contacto}>
  <div class="contenedor grid gap-14 lg:grid-cols-12 lg:gap-16">
    <div class="lg:col-span-5">
      <p class="etiqueta flex items-center gap-3 text-vino">
        <span class="h-px w-8 bg-vino" aria-hidden="true"></span>{c.etiqueta}
      </p>
      <h2 class="mt-5 text-[clamp(3rem,13vw,4.5rem)] leading-[0.92] text-carbon lg:text-[4.25rem]">
        {c.titulo} <span class="block italic text-vino">{c.tituloCursiva}</span>
      </h2>
      <p class="mt-6 max-w-md text-carbon/80">{c.intro}</p>

      <h3 class="etiqueta mt-12 flex items-center gap-4 font-sans text-vino">
        {c.tituloHorario}
        <span class="h-px flex-1 bg-carbon/20" aria-hidden="true"></span>
      </h3>
      <dl class="mt-5 space-y-4">
        {horario.map((h) => (
          <div class="flex items-end">
            <dt class="flex flex-1 items-end font-serif text-xl leading-tight sm:text-2xl">
              <span class="max-w-[9rem] sm:max-w-none">{h.dias}</span>
              <span class="guia text-carbon/45" aria-hidden="true"></span>
            </dt>
            <dd class="shrink-0 pb-px text-[0.9375rem] tabular-nums sm:text-base">{h.rango}</dd>
          </div>
        ))}
      </dl>

      <h3 class="etiqueta mt-12 flex items-center gap-4 font-sans text-vino">
        {c.tituloContacto}
        <span class="h-px flex-1 bg-carbon/20" aria-hidden="true"></span>
      </h3>
      <dl class="mt-3">
        {filas.map((f) => (
          <div class="flex min-h-12 items-center border-b border-carbon/10 last:border-b-0">
            <dt class="etiqueta w-28 shrink-0 text-[0.6875rem] text-carbon/75">{f.etiqueta}</dt>
            <dd class="min-w-0 flex-1 text-right">
              {f.href ? (
                <a href={f.href} target={f.externo ? '_blank' : undefined} rel={f.externo ? 'noopener' : undefined} class="enlace-subrayado inline-flex min-h-11 items-center font-serif text-xl">{f.texto}</a>
              ) : (
                <span class="font-serif text-xl">{f.texto}</span>
              )}
            </dd>
          </div>
        ))}
      </dl>

      <a href={contacto.whatsapp} target="_blank" rel="noopener" class="boton boton-vino mt-10 w-full sm:w-auto">
        <Icono nombre="whatsapp" />
        {d.comunes.botonWhatsApp}
      </a>
    </div>

    <div class="lg:col-span-7">
      <div class="relative h-full border border-carbon/80 p-2 [--mapa-boton-fondo:var(--color-carbon)] [--mapa-boton-texto:var(--color-hueso)] [--mapa-radio:0]">
        <MapaDiferido consulta={d.negocio.lugar} titulo={c.mapaTitulo} textoAbrir={textosBase.mapaAbrir} class="h-80 sm:h-96 lg:h-full lg:min-h-[36rem]" />
      </div>
    </div>
  </div>
</section>
