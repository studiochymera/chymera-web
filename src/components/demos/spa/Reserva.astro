---
// Reserva en línea de Bruma Spa en 4 pasos: servicio, día y hora, datos, confirmar y pagar el anticipo.
// En la demo no se cobra nada: al pagar se explica qué pasa en la página real.
// Los datos (servicios, horario, festivos y textos) llegan al script por el atributo data-reserva.
import { spa, reservables, rutas, whatsapp, minutos } from './datos';
import { pesos, rellenar } from '../../../base/formato';

const t = spa.reservas;
const c = spa.condiciones;
const r = rutas(Astro.url.pathname);

const config = {
  servicios: reservables.map((s) => ({ id: s.id, nombre: s.nombre, grupo: s.grupo, duracion: s.duracion, precio: s.precio })),
  horario: spa.horario.map((f) => ({ numeros: f.numeros, festivos: Boolean(f.festivos), abre: f.abre ?? null, cierra: f.cierra ?? null })),
  festivos: spa.festivos,
  minutos: spa.servicios.minutos,
  textos: t,
};
const paso = (n: number) => rellenar(t.pasoDe, { n: String(n) });
---

<div class="reserva" data-reserva={JSON.stringify(config)} data-incluye={spa.incluye.reservas}>
  <noscript>
    <p class="sin-js">{t.sinJs} <a class="enlace font-semibold" href={whatsapp} target="_blank" rel="noopener">{spa.botones.whatsapp}</a></p>
  </noscript>

  <ol class="indicador" aria-label={t.indicador}>
    {t.pasos.map((nombre, i) => (
      <li data-indicador={i + 1} aria-current={i === 0 ? 'step' : undefined}>
        <span class="punto" aria-hidden="true">{i + 1}</span>
        <span class="nombre">{nombre}</span>
      </li>
    ))}
  </ol>
  <p class="sr-only" aria-live="polite" aria-atomic="true" data-anuncio></p>

  <form class="flujo" data-flujo novalidate>
    <!-- 1. Servicio -->
    <section class="paso" data-paso="1" aria-labelledby="paso-1-titulo">
      <p class="paso-de">{paso(1)}</p>
      <h2 id="paso-1-titulo" class="paso-titulo" tabindex="-1">{t.titulos[0]}</h2>
      <fieldset class="mt-6" aria-describedby="error-servicio">
        <legend class="sr-only">{t.servicioLeyenda}</legend>
        <div class="servicios">
          {reservables.map((s) => (
            <label class="opcion">
              <input type="radio" name="servicio" value={s.id} class="sr-only" />
              <span class="opcion-grupo">{s.grupo}</span>
              <span class="opcion-nombre">{s.nombre}</span>
              <span class="opcion-meta">{minutos(s.duracion)} · {pesos(s.precio)}</span>
              <span class="opcion-marca" aria-hidden="true"></span>
            </label>
          ))}
        </div>
      </fieldset>
      <p class="error" id="error-servicio" data-error="servicio"></p>
      <p class="nota mt-5">{t.otrosServicios} <a class="enlace font-semibold" href={whatsapp} target="_blank" rel="noopener">{spa.botones.whatsappCorto}</a>.</p>
      <div class="acciones">
        <button type="button" class="boton boton-oliva" data-siguiente>{t.continuar} <span class="flecha" aria-hidden="true">→</span></button>
      </div>
    </section>

    <!-- 2. Día y hora -->
    <section class="paso" data-paso="2" aria-labelledby="paso-2-titulo" hidden>
      <p class="paso-de">{paso(2)}</p>
      <h2 id="paso-2-titulo" class="paso-titulo" tabindex="-1">{t.titulos[1]}</h2>
      <p class="elegido">
        <span>{t.elegiste}: <strong data-elegido></strong></span>
        <button type="button" class="enlace cambiar" data-ir="1">{t.cambiar}<span class="sr-only"> {t.resumenServicio}</span></button>
      </p>

      <fieldset class="mt-7" aria-describedby="nota-hoy error-dia">
        <legend class="leyenda">{t.diaLeyenda} <span class="leyenda-mes" data-mes></span></legend>
        <div class="calendario">
          <div class="semana" aria-hidden="true">{t.diasCortos.map((d) => <span>{d}</span>)}</div>
          <div class="dias" data-dias></div>
        </div>
        <p class="nota mt-4" id="nota-hoy">{t.notaHoy}</p>
      </fieldset>
      <p class="error" id="error-dia" data-error="dia"></p>

      <fieldset class="mt-8" aria-describedby="turnos error-hora">
        <legend class="leyenda">{t.horaLeyenda}</legend>
        <p class="nota" id="turnos" data-turnos></p>
        <div class="horas" data-horas><p class="vacio">{t.elegirDia}</p></div>
        <p class="claves" aria-hidden="true">
          <span><i class="clave-libre"></i>{t.leyendaLibre}</span>
          <span><i class="clave-ocupado"></i>{t.leyendaOcupado}</span>
          <span><i class="clave-cerrado"></i>{t.leyendaCerrado}</span>
        </p>
      </fieldset>
      <p class="error" id="error-hora" data-error="hora"></p>

      <div class="acciones">
        <button type="button" class="boton boton-borde" data-atras>{t.volver}</button>
        <button type="button" class="boton boton-oliva" data-siguiente>{t.continuar} <span class="flecha" aria-hidden="true">→</span></button>
      </div>
    </section>

    <!-- 3. Tus datos -->
    <section class="paso" data-paso="3" aria-labelledby="paso-3-titulo" hidden>
      <p class="paso-de">{paso(3)}</p>
      <h2 id="paso-3-titulo" class="paso-titulo" tabindex="-1">{t.titulos[2]}</h2>
      <div class="campos">
        <div class="campo">
          <label for="r-nombre">{t.nombre}</label>
          <input id="r-nombre" name="nombre" type="text" autocomplete="name" maxlength="80" required aria-describedby="error-nombre" />
          <p class="error" id="error-nombre" data-error="nombre"></p>
        </div>
        <div class="campo">
          <label for="r-celular">{t.celular}</label>
          <input id="r-celular" name="celular" type="tel" inputmode="numeric" autocomplete="tel-national" maxlength="16" required aria-describedby="ayuda-celular error-celular" />
          <p class="ayuda" id="ayuda-celular">{t.celularAyuda}</p>
          <p class="error" id="error-celular" data-error="celular"></p>
        </div>
        <div class="campo">
          <label for="r-correo">{t.correo}</label>
          <input id="r-correo" name="correo" type="email" autocomplete="email" maxlength="120" required aria-describedby="ayuda-correo error-correo" />
          <p class="ayuda" id="ayuda-correo">{t.correoAyuda}</p>
          <p class="error" id="error-correo" data-error="correo"></p>
        </div>
        <div>
          <div class="casilla">
            <input id="r-autoriza" name="autorizacion" type="checkbox" value="si" required aria-describedby="error-autoriza" />
            <label for="r-autoriza">{t.autorizacion} <a class="enlace font-semibold" href={r.a('privacidad/')}>{t.politica}</a>.</label>
          </div>
          <p class="error" id="error-autoriza" data-error="autoriza"></p>
        </div>
        <div class="casilla">
          <input id="r-novedades" name="novedades" type="checkbox" value="si" />
          <label for="r-novedades">{t.novedades}</label>
        </div>
      </div>
      <div class="acciones">
        <button type="button" class="boton boton-borde" data-atras>{t.volver}</button>
        <button type="button" class="boton boton-oliva" data-siguiente>{t.continuar} <span class="flecha" aria-hidden="true">→</span></button>
      </div>
    </section>

    <!-- 4. Confirmar y pagar -->
    <section class="paso" data-paso="4" aria-labelledby="paso-4-titulo" hidden>
      <p class="paso-de">{paso(4)}</p>
      <h2 id="paso-4-titulo" class="paso-titulo" tabindex="-1">{t.titulos[3]}</h2>

      <div class="resumen">
        <h3 class="resumen-titulo">{t.resumenTitulo}</h3>
        <dl>
          <div><dt>{t.resumenServicio}</dt><dd><span data-r="servicio"></span> <button type="button" class="enlace cambiar" data-ir="1">{t.cambiar}<span class="sr-only"> {t.resumenServicio}</span></button></dd></div>
          <div><dt>{t.resumenFecha}</dt><dd><span data-r="fecha"></span> <button type="button" class="enlace cambiar" data-ir="2">{t.cambiar}<span class="sr-only"> {t.resumenFecha}</span></button></dd></div>
          <div><dt>{t.resumenHora}</dt><dd data-r="hora"></dd></div>
          <div><dt>{t.resumenDuracion}</dt><dd data-r="duracion"></dd></div>
          <div><dt>{t.resumenDatos}</dt><dd><span data-r="datos"></span> <button type="button" class="enlace cambiar" data-ir="3">{t.cambiar}<span class="sr-only"> {t.resumenDatos}</span></button></dd></div>
          <div class="total"><dt>{t.resumenTotal}</dt><dd data-r="total"></dd></div>
          <div class="anticipo"><dt>{t.resumenAnticipo}</dt><dd data-r="anticipo"></dd></div>
          <div><dt>{t.resumenSaldo}</dt><dd data-r="saldo"></dd></div>
        </dl>
      </div>

      <div class="condiciones" id="condiciones" data-incluye={spa.incluye.pago}>
        <h3 class="condiciones-titulo">{c.titulo}</h3>
        <ul>
          {c.lista.map((x) => (
            <li><strong>{x.titulo}.</strong> {x.texto}</li>
          ))}
        </ul>
        <p class="sic">{c.sicTexto} <a class="enlace font-semibold" href={c.sicUrl} target="_blank" rel="noopener">{c.sic}</a>.</p>
      </div>

      <div class="casilla mt-7">
        <input id="r-acepto" name="acepto" type="checkbox" value="si" required aria-describedby="error-acepto" />
        <label for="r-acepto" class="font-semibold">{t.acepto}</label>
      </div>
      <p class="error" id="error-acepto" data-error="acepto"></p>

      <div class="acciones">
        <button type="button" class="boton boton-borde" data-atras>{t.volver}</button>
        <button type="submit" class="boton boton-oliva pagar" data-pagar>{t.pagar}</button>
      </div>
      <p class="nota mt-4">{t.pagoSeguro}</p>

      <div class="estado" role="status" data-estado></div>
      <button type="button" class="enlace otra" data-otra hidden>{t.otraReserva}</button>
    </section>
  </form>
</div>

<script>
  import { pesos, hora, rellenar } from '../../../base/formato';

  type Servicio = { id: string; nombre: string; grupo: string; duracion: number; precio: number };
  type Fila = { numeros: number[]; festivos: boolean; abre: string | null; cierra: string | null };

  const raiz = document.querySelector<HTMLElement>('[data-reserva]');
  if (raiz) iniciar(raiz);

  function iniciar(raiz: HTMLElement) {
    const cfg = JSON.parse(raiz.dataset.reserva!) as {
      servicios: Servicio[];
      horario: Fila[];
      festivos: string[];
      minutos: string;
      textos: Record<string, any>;
    };
    const t = cfg.textos;
    const form = raiz.querySelector<HTMLFormElement>('[data-flujo]')!;
    const pasos = [...raiz.querySelectorAll<HTMLElement>('[data-paso]')];
    const indicadores = [...raiz.querySelectorAll<HTMLElement>('[data-indicador]')];
    const anuncio = raiz.querySelector<HTMLElement>('[data-anuncio]')!;
    const cajaDias = raiz.querySelector<HTMLElement>('[data-dias]')!;
    const cajaHoras = raiz.querySelector<HTMLElement>('[data-horas]')!;
    const turnos = raiz.querySelector<HTMLElement>('[data-turnos]')!;
    const estado = raiz.querySelector<HTMLElement>('[data-estado]')!;
    const otra = raiz.querySelector<HTMLButtonElement>('[data-otra]')!;
    const botonPagar = raiz.querySelector<HTMLButtonElement>('[data-pagar]')!;
    let actual = 1;

    const dos = (n: number) => String(n).padStart(2, '0');
    const clave = (d: Date) => `${d.getFullYear()}-${dos(d.getMonth() + 1)}-${dos(d.getDate())}`;
    const aMin = (hhmm: string) => {
      const [h, m] = hhmm.split(':').map(Number);
      return h * 60 + m;
    };
    const aHhmm = (min: number) => `${dos(Math.floor(min / 60))}:${dos(min % 60)}`;
    const minutos = (n: number) => rellenar(cfg.minutos, { n: String(n) });
    const anticipo = (precio: number) => Math.round((precio * t.porcentajeAnticipo) / 100);
    const fechaDe = (k: string) => {
      const [a, m, d] = k.split('-').map(Number);
      return new Date(a, m - 1, d);
    };
    const fechaLarga = (d: Date) => rellenar(t.fechaLarga, { dia: t.diasSemana[d.getDay()], numero: String(d.getDate()), mes: t.meses[d.getMonth()] });

    // Turnos ocupados de forma determinista (cerca del 30 %): hash FNV-1a de fecha y hora.
    const ocupado = (fecha: string, hhmm: string) => {
      let h = 2166136261;
      for (const ch of `${fecha}T${hhmm}`) {
        h ^= ch.charCodeAt(0);
        h = Math.imul(h, 16777619);
      }
      return (h >>> 0) % 100 < t.ocupacion;
    };

    // Horario del día: lunes cerrado; festivos (que no caen en lunes) con horario de domingo.
    const horarioDe = (d: Date): Fila | null => {
      const dia = d.getDay();
      if (cfg.festivos.includes(clave(d)) && dia !== 1) return cfg.horario.find((f) => f.festivos) ?? null;
      const fila = cfg.horario.find((f) => f.numeros.includes(dia));
      return fila && fila.abre ? fila : null;
    };

    const valor = (nombre: string) => (form.elements.namedItem(nombre) as RadioNodeList | HTMLInputElement | null)?.value ?? '';
    const servicio = () => cfg.servicios.find((s) => s.id === valor('servicio'));

    function error(nombre: string, texto = '') {
      const p = raiz.querySelector<HTMLElement>(`[data-error="${nombre}"]`);
      if (p) p.textContent = texto;
      const campo = form.querySelector<HTMLInputElement>(`input[aria-describedby~="error-${nombre}"]`);
      if (campo && texto) campo.setAttribute('aria-invalid', 'true');
      else campo?.removeAttribute('aria-invalid');
    }

    // ----- Calendario de los próximos días (desde mañana) -----
    const inicio = new Date();
    inicio.setHours(0, 0, 0, 0);
    const dias = Array.from({ length: t.dias }, (_, i) => new Date(inicio.getFullYear(), inicio.getMonth(), inicio.getDate() + 1 + i));
    const meses = [...new Set(dias.map((d) => d.getMonth()))].map((m) => t.meses[m]);
    raiz.querySelector('[data-mes]')!.textContent = `· ${meses.join(' y ')} ${dias[dias.length - 1].getFullYear()}`;

    const vacios = (dias[0].getDay() + 6) % 7;
    cajaDias.innerHTML = '<span class="dia-vacio"></span>'.repeat(vacios);
    dias.forEach((d, i) => {
      const k = clave(d);
      const h = horarioDe(d);
      const festivo = cfg.festivos.includes(k);
      const mesCorto = i === 0 || d.getDate() === 1 ? `<span class="dia-mes" aria-hidden="true">${t.meses[d.getMonth()].slice(0, 3)}</span>` : '';
      const nombre = `${fechaLarga(d)}${festivo ? `, ${t.festivo}` : ''}`;
      if (!h) {
        cajaDias.insertAdjacentHTML('beforeend', `<span class="dia dia-cerrado">${mesCorto}<span class="dia-num" aria-hidden="true">${d.getDate()}</span><span class="sr-only">${nombre}, ${t.cerrado}</span></span>`);
      } else {
        cajaDias.insertAdjacentHTML(
          'beforeend',
          `<label class="dia${festivo ? ' dia-festivo' : ''}"><input type="radio" name="dia" value="${k}" class="sr-only">${mesCorto}<span class="dia-num" aria-hidden="true">${d.getDate()}</span><span class="sr-only">${nombre}</span></label>`,
        );
      }
    });

    // ----- Horas del día elegido -----
    function pintarHoras() {
      const s = servicio();
      const dia = valor('dia');
      const elegida = valor('hora');
      if (s) turnos.textContent = rellenar(t.turnos, { duracion: minutos(s.duracion) });
      if (!s || !dia) {
        cajaHoras.innerHTML = `<p class="vacio">${t.elegirDia}</p>`;
        return;
      }
      const h = horarioDe(fechaDe(dia))!;
      const lista: { hhmm: string; libre: boolean }[] = [];
      for (let m = aMin(h.abre!); m + s.duracion <= aMin(h.cierra!); m += t.intervalo) {
        const hhmm = aHhmm(m);
        lista.push({ hhmm, libre: !ocupado(dia, hhmm) });
      }
      if (!lista.some((x) => x.libre)) {
        cajaHoras.innerHTML = `<p class="vacio">${t.sinHoras}</p>`;
        return;
      }
      const grupo = (titulo: string, items: typeof lista) =>
        items.length
          ? `<div class="horas-grupo"><p class="horas-titulo">${titulo}</p><div class="horas-lista">${items
              .map(
                (x) =>
                  `<label class="hora${x.libre ? '' : ' hora-ocupada'}"><input type="radio" name="hora" value="${x.hhmm}" class="sr-only"${x.libre ? '' : ' disabled'}${x.libre && x.hhmm === elegida ? ' checked' : ''}><span>${hora(x.hhmm)}</span>${x.libre ? '' : `<span class="sr-only">, ${t.ocupado}</span>`}</label>`,
              )
              .join('')}</div></div>`
          : '';
      cajaHoras.innerHTML = grupo(t.manana, lista.filter((x) => aMin(x.hhmm) < 720)) + grupo(t.tarde, lista.filter((x) => aMin(x.hhmm) >= 720));
    }

    // ----- Resumen y pago -----
    function pintarResumen() {
      const s = servicio()!;
      const dia = fechaDe(valor('dia'));
      const inicioMin = aMin(valor('hora'));
      const celular = valor('celular').replace(/\D/g, '').replace(/^57(?=3\d{9}$)/, '');
      const datos = [valor('nombre').trim(), celular.replace(/^(\d{3})(\d{3})(\d{4})$/, '$1 $2 $3'), valor('correo').trim()];
      const pon = (k: string, v: string) => (raiz.querySelector(`[data-r="${k}"]`)!.textContent = v);
      pon('servicio', s.nombre);
      pon('fecha', fechaLarga(dia));
      const fija = (hhmm: string) => hora(hhmm).replace(/ /g, '\u00a0');
      pon('hora', rellenar(t.horaRango, { inicio: fija(aHhmm(inicioMin)), fin: fija(aHhmm(inicioMin + s.duracion)) }));
      pon('duracion', minutos(s.duracion));
      pon('datos', datos.join('\n'));
      pon('total', pesos(s.precio));
      pon('anticipo', pesos(anticipo(s.precio)));
      pon('saldo', pesos(s.precio - anticipo(s.precio)));
      botonPagar.textContent = rellenar(t.pagar, { monto: pesos(anticipo(s.precio)) });
    }

    // ----- Validación de cada paso -----
    function validar(n: number): HTMLElement | null {
      let primero: HTMLElement | null = null;
      const marca = (nombre: string, texto: string, foco: HTMLElement | null) => {
        error(nombre, texto);
        if (texto && !primero) primero = foco;
      };
      if (n === 1) {
        marca('servicio', servicio() ? '' : t.errorServicio, form.querySelector('input[name="servicio"]'));
      }
      if (n === 2) {
        marca('dia', valor('dia') ? '' : t.errorDia, form.querySelector('input[name="dia"]'));
        marca('hora', !valor('dia') || valor('hora') ? '' : t.errorHora, form.querySelector('input[name="hora"]:not(:disabled)'));
      }
      if (n === 3) {
        const nombre = valor('nombre').trim();
        const celular = valor('celular').replace(/\D/g, '').replace(/^57(?=3\d{9}$)/, '');
        const correo = valor('correo').trim();
        marca('nombre', nombre.length >= 3 && /\S\s+\S/.test(nombre) ? '' : t.errorNombre, form.querySelector('#r-nombre'));
        marca('celular', /^3\d{9}$/.test(celular) ? '' : t.errorCelular, form.querySelector('#r-celular'));
        marca('correo', /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(correo) ? '' : t.errorCorreo, form.querySelector('#r-correo'));
        marca('autoriza', form.querySelector<HTMLInputElement>('#r-autoriza')!.checked ? '' : t.errorAutorizacion, form.querySelector('#r-autoriza'));
      }
      if (n === 4) {
        marca('acepto', form.querySelector<HTMLInputElement>('#r-acepto')!.checked ? '' : t.errorAcepto, form.querySelector('#r-acepto'));
      }
      return primero;
    }

    // ----- Navegación entre pasos -----
    function irA(n: number, foco = true) {
      actual = n;
      pasos.forEach((p) => (p.hidden = Number(p.dataset.paso) !== n));
      indicadores.forEach((li) => {
        const i = Number(li.dataset.indicador);
        if (i === n) li.setAttribute('aria-current', 'step');
        else li.removeAttribute('aria-current');
        li.dataset.fase = i < n ? 'hecho' : i === n ? 'actual' : '';
      });
      if (n === 2) {
        raiz.querySelector('[data-elegido]')!.textContent = servicio()?.nombre ?? '';
        pintarHoras();
      }
      if (n === 4) pintarResumen();
      anuncio.textContent = rellenar(t.anuncioPaso, { n: String(n), titulo: t.titulos[n - 1] });
      if (foco) {
        const titulo = raiz.querySelector<HTMLElement>(`#paso-${n}-titulo`)!;
        titulo.focus({ preventScroll: true });
        const arriba = raiz.getBoundingClientRect().top + window.scrollY - 96;
        if (window.scrollY > arriba) window.scrollTo({ top: arriba, behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' });
      }
    }

    function siguiente() {
      const invalido = validar(actual);
      if (invalido) {
        invalido.focus();
        return;
      }
      if (actual < 4) irA(actual + 1);
    }

    function pagar() {
      const invalido = validar(4);
      if (invalido) {
        invalido.focus();
        return;
      }
      estado.innerHTML = '';
      const titulo = document.createElement('p');
      titulo.className = 'estado-titulo';
      titulo.textContent = t.demoTitulo;
      const texto = document.createElement('p');
      texto.textContent = t.demoTexto;
      estado.append(titulo, texto);
      otra.hidden = false;
    }

    raiz.addEventListener('click', (e) => {
      const el = (e.target as HTMLElement).closest<HTMLElement>('[data-siguiente], [data-atras], [data-ir], [data-otra]');
      if (!el) return;
      if (el.matches('[data-siguiente]')) siguiente();
      else if (el.matches('[data-atras]')) irA(Math.max(1, actual - 1));
      else if (el.matches('[data-ir]')) irA(Number(el.dataset.ir));
      else if (el.matches('[data-otra]')) {
        form.reset();
        estado.innerHTML = '';
        otra.hidden = true;
        raiz.querySelectorAll<HTMLElement>('[data-error]').forEach((p) => error(p.dataset.error!));
        irA(1);
      }
    });

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      if (actual === 4) pagar();
      else siguiente();
    });

    form.addEventListener('change', (e) => {
      const el = e.target as HTMLInputElement;
      if (el.name === 'servicio') {
        error('servicio');
        if (valor('dia')) pintarHoras();
      }
      if (el.name === 'dia') {
        error('dia');
        error('hora');
        pintarHoras();
      }
      if (el.name === 'hora') error('hora');
      if (el.id === 'r-autoriza' && el.checked) error('autoriza');
      if (el.id === 'r-acepto' && el.checked) error('acepto');
    });

    // Si llega ?servicio=<id>, se elige ese servicio y se pasa al paso 2.
    const pedido = new URLSearchParams(location.search).get('servicio');
    const radio = pedido ? form.querySelector<HTMLInputElement>(`input[name="servicio"][value="${CSS.escape(pedido)}"]`) : null;
    if (radio) {
      radio.checked = true;
      irA(2, false);
    } else {
      irA(1, false);
      anuncio.textContent = '';
    }
  }
</script>

