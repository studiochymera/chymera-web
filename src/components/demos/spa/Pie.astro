---
// Pie de Bruma Spa: datos del negocio, horario, contacto, legal, SIC y crédito de Chymera.
import { spa, site, rutas, whatsapp, horario } from './datos';

const p = spa.pie;
const c = spa.contacto;
const r = rutas(Astro.url.pathname);
---

<footer class="oscuro relative overflow-hidden pb-28 lg:pb-16">
  <div class="contenedor pt-16 lg:pt-24">
    <div class="grid gap-12 lg:grid-cols-12 lg:gap-8">
      <div class="lg:col-span-4">
        <p class="font-titulo text-[4.5rem] leading-[0.85] font-[300] tracking-[-0.04em] sm:text-[6rem]">
          {spa.negocio.marca}<span class="numeral ml-2 text-[0.4em] text-arcilla-clara">{spa.negocio.apellido}</span>
        </p>
        <p class="mt-5 max-w-xs text-arena/80">{p.frase}</p>
      </div>

      <div class="grid gap-10 sm:grid-cols-3 lg:col-span-8 lg:gap-12" data-incluye={spa.incluye.pie}>
        <div>
          <h2 class="antetitulo text-arcilla-clara">{p.visitanos}</h2>
          <p class="mt-4 font-semibold">{spa.negocio.nombre}</p>
          <p class="text-arena/80">{p.ubicacion}</p>
          <ul class="mt-3 space-y-1 text-sm leading-relaxed text-arena/80">
            {horario.map((f) => <li><span class="font-semibold text-arena">{f.corto}</span> · {f.horas}</li>)}
          </ul>
        </div>
        <div>
          <h2 class="antetitulo text-arcilla-clara">{p.escribenos}</h2>
          <ul class="mt-2.5 text-[0.9375rem]">
            <li><a class="enlace inline-flex min-h-11 items-center" href={whatsapp} target="_blank" rel="noopener">{p.whatsapp}</a></li>
            <li><a class="enlace inline-flex min-h-11 items-center" href={`tel:${c.telefonoEnlace}`}>{c.telefono}</a></li>
            <li><a class="enlace inline-flex min-h-11 items-center break-all" href={`mailto:${c.correo}`}>{c.correo}</a></li>
            <li><a class="enlace inline-flex min-h-11 items-center" href={c.instagram} target="_blank" rel="noopener">{c.instagramTexto}</a></li>
          </ul>
        </div>
        <div>
          <h2 class="antetitulo text-arcilla-clara">{p.legal}</h2>
          <ul class="mt-2.5 text-[0.9375rem]">
            <li><a class="enlace inline-flex min-h-11 items-center" href={r.a('privacidad/')}>{p.privacidad}</a></li>
            <li><a class="enlace inline-flex min-h-11 items-center" href={r.a('contacto/#preguntas')}>{p.condiciones}</a></li>
          </ul>
          <p class="mt-2 text-sm leading-relaxed text-arena/80">
            {p.sicTexto} <a class="enlace font-semibold text-arena" href={p.sicUrl} target="_blank" rel="noopener">{p.sic}</a>.
          </p>
        </div>
      </div>
    </div>

    <div class="mt-16 flex flex-col gap-3 border-t border-arena/15 pt-6 text-sm text-arena/75 sm:flex-row sm:items-center sm:justify-between">
      <p>{p.precios}</p>
      <a class="enlace inline-flex min-h-11 items-center" href={r.raiz}>{site.demos.textosBase.hechoPor}</a>
    </div>
  </div>
</footer>
