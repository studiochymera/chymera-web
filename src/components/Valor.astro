---
// Muestra un valor de la tabla de planes: "Sí" y "No" como íconos, lo demás como texto.
interface Props {
  valor: string;
  claro?: boolean;
}

const { valor, claro = false } = Astro.props;
---

{valor === 'Sí' ? (
  <span class="inline-flex shrink-0 items-center align-middle">
    <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true" class:list={[claro ? 'text-celeste' : 'text-azul']}>
      <path fill="currentColor" d="M8.1 14.6 3.6 10.1l1.4-1.4 3.1 3.1 6.9-6.9 1.4 1.4z" />
    </svg>
    <span class="sr-only">Incluido</span>
  </span>
) : valor === 'No' ? (
  <span class="inline-flex shrink-0 items-center align-middle">
    <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true" class="text-tinta/35">
      <path fill="currentColor" d="M5 9.2h10v1.6H5z" />
    </svg>
    <span class="sr-only">No incluido</span>
  </span>
) : valor === 'Extra' ? (
  <span class="rounded-full border border-azul/25 px-2 py-0.5 text-xs font-semibold text-azul">Extra</span>
) : (
  <span>{valor}</span>
)}
