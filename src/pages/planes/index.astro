---
import Base from '../../layouts/Base.astro';
import Encabezado from '../../components/Encabezado.astro';
import Pie from '../../components/Pie.astro';
import BotonWhatsApp from '../../components/BotonWhatsApp.astro';
import Valor from '../../components/Valor.astro';
import CierrePlanes from '../../components/CierrePlanes.astro';
import site from '../../data/site.json';

const d = site.detallePlanes;
const titulo = `${d.titulo} · ${site.nombre}`;
---

<Base titulo={titulo} descripcion={d.intro}>
  <Encabezado />

  <main>
    <!-- Portada -->
    <section class="bg-azul text-crema">
      <div class="contenedor py-14 sm:py-20">
        <nav aria-label="Ruta" class="text-sm text-crema/60">
          <a href="../" class="hover:text-crema">Inicio</a>
          <span aria-hidden="true" class="mx-2">/</span>
          <span class="text-crema">Planes</span>
        </nav>
        <h1 class="mt-5 max-w-3xl text-4xl font-semibold leading-tight text-crema sm:text-5xl">{d.titulo}</h1>
        <p class="mt-5 max-w-2xl text-lg text-crema/80">{d.intro}</p>

        <div class="mt-10 grid gap-4 md:grid-cols-3">
          {site.paquetes.map((p) => (
            <a
              href={`${p.slug}/`}
              class:list={[
                'group flex flex-col rounded-2xl p-6 transition',
                p.destacado ? 'border border-transparent bg-crema text-azul ring-2 ring-celeste' : 'border border-crema/20 hover:border-celeste',
              ]}
            >
              <span class:list={['font-display text-xl font-semibold', p.destacado ? 'text-azul' : 'text-crema']}>{p.nombre}</span>
              <span class="mt-3 font-display text-3xl font-semibold">${p.precio}</span>
              <span class:list={['text-sm', p.destacado ? 'text-tinta/70' : 'text-crema/70']}>COP + ${p.mensual} al mes</span>
              <span class:list={['mt-4 text-sm', p.destacado ? 'text-tinta/75' : 'text-crema/75']}>{p.resumen}</span>
              <span class:list={['mt-auto pt-5 text-sm font-semibold underline underline-offset-4', p.destacado ? 'text-azul' : 'text-celeste']}>
                {d.verDetalle}
              </span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- Comparación -->
    <section id="comparar" class="py-16 sm:py-24">
      <div class="contenedor">
        <h2 class="text-3xl font-semibold sm:text-4xl">{d.comparar}</h2>
        <p class="mt-3 text-sm text-tinta/60 md:hidden">{d.deslizar}</p>
        <div class="relative mt-6 overflow-x-auto rounded-2xl border border-azul/10 bg-crema">
          <table class="w-full min-w-[640px] border-collapse text-left text-sm">
            <caption class="sr-only">{d.comparar}</caption>
            <colgroup>
              <col class="w-[34%]" />
              {site.paquetes.map(() => <col class="w-[22%]" />)}
            </colgroup>
            <thead>
              <tr class="bg-azul text-crema">
                <th scope="col" class="sticky left-0 z-10 bg-azul px-4 py-4 font-medium text-crema/70">Qué recibes</th>
                {site.paquetes.map((p) => (
                  <th scope="col" class="px-4 py-4">
                    <a href={`${p.slug}/`} class="font-display text-base font-semibold text-crema hover:text-celeste">{p.nombre}</a>
                  </th>
                ))}
              </tr>
            </thead>
            <tbody>
              {d.comparacion.map((fila, i) => (
                <tr class:list={['border-t border-azul/10', i % 2 === 1 ? 'bg-crema-2' : 'bg-crema']}>
                  <th scope="row" class:list={['sticky left-0 z-10 max-w-[11rem] px-4 py-3 font-medium text-azul sm:max-w-none', i % 2 === 1 ? 'bg-crema-2' : 'bg-crema']}>{fila.titulo}</th>
                  {fila.valores.map((v) => (
                    <td class="px-4 py-3 align-middle text-tinta/80"><Valor valor={v} /></td>
                  ))}
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        <!-- Servicios vs planes -->
        <h3 class="mt-16 text-2xl font-semibold">{d.definicionesTitulo}</h3>
        <div class="mt-6 grid gap-5 md:grid-cols-2">
          {d.definiciones.map((def) => (
            <article class="rounded-2xl border border-azul/10 bg-white/60 p-6">
              <h4 class="font-display text-lg font-semibold text-azul">{def.titulo}</h4>
              <p class="mt-2 text-tinta/75">{def.texto}</p>
              <p class="mt-4 rounded-xl bg-crema-2 px-4 py-3 text-sm text-azul">{def.ejemplo}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- Reglas -->
    <section class="bg-crema-2 py-16 sm:py-24">
      <div class="contenedor">
        <h2 class="text-3xl font-semibold sm:text-4xl">{d.reglasTitulo}</h2>
        <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
          {d.reglas.map((regla) => (
            <article class="rounded-2xl border border-azul/10 bg-crema p-6">
              <h3 class="text-lg font-semibold">{regla.titulo}</h3>
              <p class="mt-2 text-sm text-tinta/75">{regla.texto}</p>
            </article>
          ))}
        </div>

        <div class="mt-10 grid gap-5 md:grid-cols-2">
          <div class="rounded-2xl bg-azul p-6 text-crema">
            <h3 class="text-lg font-semibold text-crema">{d.siempreTitulo}</h3>
            <ul class="mt-4 space-y-2 text-sm">
              {d.siempre.map((s) => <li class="flex gap-2"><Valor valor="Sí" claro /><span>{s}</span></li>)}
            </ul>
          </div>
          <div class="rounded-2xl border border-dashed border-azul/30 p-6">
            <h3 class="text-lg font-semibold">{d.nuncaTitulo}</h3>
            <ul class="mt-4 space-y-2 text-sm text-tinta/75">
              {d.nunca.map((n) => <li class="flex gap-2"><Valor valor="No" /><span>{n}</span></li>)}
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- Planes mensuales -->
    <section id="mensuales" class="py-16 sm:py-24">
      <div class="contenedor">
        <h2 class="text-3xl font-semibold sm:text-4xl">{d.mensualesTitulo}</h2>
        <p class="mt-3 max-w-2xl text-tinta/75">{d.mensualesIntro}</p>
        <div class="mt-10 grid gap-5 md:grid-cols-2">
          {site.planes.map((pl) => (
            <article class="rounded-2xl border border-azul/10 bg-white/60 p-6 sm:p-7">
              <div class="flex flex-wrap items-baseline justify-between gap-2">
                <h3 class="text-2xl font-semibold">Plan {pl.nombre}</h3>
                <p><span class="font-display text-2xl font-semibold text-azul">${pl.precio}</span> <span class="text-sm text-tinta/60">al mes</span></p>
              </div>
              <ul class="mt-5 space-y-2 text-sm">
                {pl.items.map((it) => <li class="flex gap-2"><Valor valor="Sí" /><span>{it}</span></li>)}
              </ul>
            </article>
          ))}
        </div>
        <div class="mt-5 grid gap-5 md:grid-cols-2">
          <div class="rounded-2xl bg-crema-2 p-6">
            <h3 class="text-lg font-semibold">{d.cambiosSiTitulo}</h3>
            <ul class="mt-3 space-y-2 text-sm text-tinta/80">
              {d.cambiosSi.map((c) => <li class="flex gap-2"><Valor valor="Sí" /><span>{c}</span></li>)}
            </ul>
          </div>
          <div class="rounded-2xl bg-crema-2 p-6">
            <h3 class="text-lg font-semibold">{d.cambiosNoTitulo}</h3>
            <ul class="mt-3 space-y-2 text-sm text-tinta/80">
              {d.cambiosNo.map((c) => <li class="flex gap-2"><Valor valor="No" /><span>{c}</span></li>)}
            </ul>
          </div>
        </div>
      </div>
    </section>

    <CierrePlanes />
  </main>

  <Pie />

  <BotonWhatsApp />
</Base>
