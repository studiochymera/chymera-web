---
import LayoutSpa from '../../../../components/demos/spa/LayoutSpa.astro';
import Cabecera from '../../../../components/demos/spa/Cabecera.astro';
import FormularioContacto from '../../../../base/FormularioContacto.astro';
import MapaDiferido from '../../../../base/MapaDiferido.astro';
import { schemaPreguntas } from '../../../../base/schema';
import { spa, site, rutas, whatsapp, horario } from '../../../../components/demos/spa/datos';

const p = spa.paginas.contacto;
const c = spa.contacto;
const r = rutas(Astro.url.pathname);
const canales = [
  { etiqueta: p.etiquetas.whatsapp, valor: p.whatsappValor, href: whatsapp, externo: true },
  { etiqueta: p.etiquetas.telefono, valor: c.telefono, href: `tel:${c.telefonoEnlace}`, externo: false },
  { etiqueta: p.etiquetas.correo, valor: c.correo, href: `mailto:${c.correo}`, externo: false },
  { etiqueta: p.etiquetas.redes, valor: c.instagramTexto, href: c.instagram, externo: true },
];
---

<LayoutSpa titulo={p.titulo} descripcion={p.descripcion} schemas={[schemaPreguntas(spa.preguntas)]}>
  <Cabecera antetitulo={p.antetitulo} titulo={p.h1} entrada={p.entrada} />

  <section class="py-16 lg:py-24">
    <div class="contenedor grid gap-14 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-5">
        <div data-incluye={spa.incluye.contacto}>
          <h2 class="antetitulo">{p.canales}</h2>
          <ul class="mt-4">
            {canales.map((k) => (
              <li class="border-b border-oliva/15">
                <a
                  href={k.href}
                  target={k.externo ? '_blank' : undefined}
                  rel={k.externo ? 'noopener' : undefined}
                  class="canal group flex min-h-16 items-center justify-between gap-4 py-3"
                >
                  <span>
                    <span class="block text-xs font-semibold tracking-[0.14em] text-barro uppercase">{k.etiqueta}</span>
                    <span class="mt-1 block font-titulo text-[1.375rem] leading-tight break-all sm:text-2xl">{k.valor}</span>
                  </span>
                  <span class="text-xl transition-transform duration-300 group-hover:translate-x-1" aria-hidden="true">→</span>
                </a>
              </li>
            ))}
          </ul>

          <h2 class="antetitulo mt-14">{p.horarioTitulo}</h2>
          <table class="mt-4 w-full text-left">
            <tbody>
              {horario.map((f) => (
                <tr class="border-b border-oliva/15">
                  <th scope="row" class="py-4 pr-4 align-top font-semibold">{f.dias}</th>
                  <td class:list={['py-4 text-right', f.cerrado && 'text-oliva-suave']}>{f.horas}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>

      <div class="lg:col-span-7">
        <div class="formulario-spa border border-oliva/15 bg-arena-2 px-5 py-8 sm:px-10 sm:py-12" data-incluye={spa.incluye.formulario}>
          <h2 class="text-3xl sm:text-4xl">{p.formularioTitulo}</h2>
          <div class="mt-8">
          <FormularioContacto
            textos={site.demos.textosBase.formulario}
            negocio={spa.negocio.nombre}
            enlacePolitica={r.a('privacidad/')}
            modo="demo"
          />
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-arena-2 py-16 lg:py-24" data-incluye={spa.incluye.mapa}>
    <div class="contenedor grid gap-10 lg:grid-cols-12 lg:items-end lg:gap-16">
      <div class="lg:col-span-5 lg:pb-10">
        <h2 class="text-4xl sm:text-5xl">{p.mapaTitulo}</h2>
        <p class="mt-5 max-w-md text-oliva-suave">{p.mapaTexto}</p>
      </div>
      <div class="lg:col-span-7">
        <MapaDiferido consulta={c.mapaConsulta} titulo={c.mapaTitulo} textoAbrir={site.demos.textosBase.mapaAbrir} class="mapa-spa arco block aspect-[4/5] w-full sm:aspect-[5/4]" />
      </div>
    </div>
  </section>

  <section id="preguntas" class="py-16 lg:py-28" data-incluye={spa.incluye.preguntas}>
    <div class="contenedor grid gap-10 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-4">
        <h2 class="text-4xl sm:text-5xl lg:sticky lg:top-28">{p.preguntasTitulo}</h2>
      </div>
      <div class="lg:col-span-8">
        {spa.preguntas.map((q, i) => (
          <details class="pregunta border-t border-oliva/15 last:border-b">
            <summary class="flex min-h-16 cursor-pointer list-none items-center gap-4 py-4">
              <span class="numeral w-7 shrink-0 text-sm text-barro" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              <span class="flex-1 font-titulo text-[1.1875rem] leading-snug sm:text-[1.3125rem]">{q.p}</span>
              <span class="mas" aria-hidden="true"></span>
            </summary>
            <p class="pb-6 pl-11 text-oliva-suave">{q.r}</p>
          </details>
        ))}
      </div>
    </div>
  </section>
</LayoutSpa>

<style>
  .formulario-spa {
    --form-campo: var(--color-arena);
    --form-borde: #6f766a;
    --form-texto: var(--color-oliva);
    --form-acento: var(--color-oliva);
    --form-acento-texto: var(--color-arena);
    --form-radio: 2px;
  }
  .formulario-spa :global(.enviar) {
    border-radius: 9999px;
    min-height: 3rem;
  }
  .formulario-spa :global(.autoriza a) {
    font-weight: 600;
  }
  :global(.mapa-spa) {
    --mapa-boton-fondo: var(--color-oliva);
    --mapa-boton-texto: var(--color-arena);
  }
  .canal:hover .font-titulo {
    color: var(--color-barro);
  }
  .pregunta summary::-webkit-details-marker {
    display: none;
  }
  .mas {
    position: relative;
    width: 1rem;
    height: 1rem;
    flex-shrink: 0;
  }
  .mas::before,
  .mas::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 0;
    width: 100%;
    height: 1.5px;
    background: currentColor;
    transition: transform 0.3s var(--ease-bruma);
  }
  .mas::after {
    transform: rotate(90deg);
  }
  .pregunta[open] .mas::after {
    transform: rotate(0deg);
  }
  .pregunta[open] > p {
    animation: subir 0.4s var(--ease-bruma) both;
  }
</style>
