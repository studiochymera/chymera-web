---
import LayoutSpa from '../../../../components/demos/spa/LayoutSpa.astro';
import Cabecera from '../../../../components/demos/spa/Cabecera.astro';
import Foto from '../../../../components/demos/spa/Foto.astro';
import { spa, rutas } from '../../../../components/demos/spa/datos';

const p = spa.paginas.nosotros;
const r = rutas(Astro.url.pathname);
const n = (i: number) => String(i + 1).padStart(2, '0');
---

<LayoutSpa titulo={p.titulo} descripcion={p.descripcion}>
  <Cabecera antetitulo={p.antetitulo} titulo={p.h1} entrada={p.entrada}>
    <Foto slot="lado" foto="nosotros" alt={p.alt} proporcion="5/4" prioridad={true} sizes="(min-width: 1024px) 40vw, 92vw" anchos={[480, 800, 1200]} />
  </Cabecera>

  <section class="py-20 lg:py-32" data-incluye={spa.incluye.historia}>
    <div class="contenedor grid gap-10 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-5">
        <p class="antetitulo">{p.historia.antetitulo}</p>
        <h2 class="mt-5 max-w-[13ch] text-4xl sm:text-5xl">{p.historia.titulo}</h2>
      </div>
      <div class="lg:col-span-7">
        {p.historia.parrafos.map((t, i) => (
          <p class:list={['text-[1.0625rem] text-oliva-suave', i === 0 ? 'font-titulo text-[1.375rem] leading-snug font-[340] text-oliva sm:text-2xl' : 'mt-6']}>{t}</p>
        ))}
        <ol class="mt-12 grid gap-px border-t border-oliva/15 sm:grid-cols-3">
          {p.historia.hitos.map((h) => (
            <li class="border-b border-oliva/15 py-5 sm:border-b-0 sm:pr-6">
              <span class="numeral block text-4xl text-barro">{h.año}</span>
              <span class="mt-2 block text-[0.9375rem]">{h.texto}</span>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <section class="relative overflow-hidden bg-salvia-claro py-20 lg:py-28" data-incluye={spa.incluye.historia}>
    <div class="bruma absolute inset-0" aria-hidden="true"></div>
    <div class="contenedor relative">
      <p class="antetitulo">{p.filosofia.antetitulo}</p>
      <h2 class="mt-5 text-4xl sm:text-5xl">{p.filosofia.titulo}</h2>
      <ol class="mt-12 grid gap-10 md:grid-cols-3 md:gap-8">
        {p.filosofia.items.map((f, i) => (
          <li class="border-t border-oliva/25 pt-6">
            <span class="numeral text-6xl leading-none text-barro" aria-hidden="true">{n(i)}</span>
            <h3 class="mt-4 text-2xl">{f.titulo}</h3>
            <p class="mt-3 text-oliva-suave">{f.texto}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="py-20 lg:py-32" data-incluye={spa.incluye.equipo}>
    <div class="contenedor">
      <div class="flex flex-col gap-6 sm:flex-row sm:items-end sm:justify-between">
        <div>
          <p class="antetitulo">{p.equipo.antetitulo}</p>
          <h2 class="mt-5 text-4xl sm:text-5xl">{p.equipo.titulo}</h2>
        </div>
        <a href={r.reservar()} class="boton boton-oliva self-start sm:self-auto">{spa.botones.reservar} <span class="flecha" aria-hidden="true">→</span></a>
      </div>
      <ul class="equipo mt-14 grid grid-cols-2 gap-x-4 gap-y-12 sm:grid-cols-3 lg:grid-cols-5 lg:gap-x-6">
        {spa.terapeutas.map((t, i) => (
          <li class="persona">
            <Foto foto={t.foto} alt={t.alt} proporcion="3/4" sizes="(min-width: 1024px) 18vw, (min-width: 640px) 30vw, 46vw" anchos={[320, 640, 900]} />
            <span class="numeral mt-4 block text-sm text-oliva-suave" aria-hidden="true">{n(i)}</span>
            <h3 class="mt-1 text-xl leading-tight sm:text-2xl">{t.nombre}</h3>
            <p class="mt-1.5 text-xs font-semibold tracking-[0.12em] text-barro uppercase">{t.rol}</p>
            <p class="mt-3 text-sm text-oliva-suave">{t.texto}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>
</LayoutSpa>

<style>
  @media (width < 40rem) {
    .persona:nth-child(even) {
      transform: translateY(2.5rem);
    }
    .equipo {
      padding-bottom: 2.5rem;
    }
  }
  @media (width >= 64rem) {
    .persona:nth-child(even) {
      transform: translateY(3.5rem);
    }
    .equipo {
      padding-bottom: 3.5rem;
    }
  }
</style>
