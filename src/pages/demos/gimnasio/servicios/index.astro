---
import LayoutForja from '../../../../components/demos/gimnasio/LayoutForja.astro';
import CabeceraPagina from '../../../../components/demos/gimnasio/CabeceraPagina.astro';
import Llamado from '../../../../components/demos/gimnasio/Llamado.astro';
import Icono from '../../../../components/demos/gimnasio/Icono.astro';
import { datos as d, contacto, cifraPesos, precio } from '../../../../components/demos/gimnasio/datos';
import { rellenar } from '../../../../base/formato';

const p = d.paginas.servicios;
const filas = d.membresias.filas;
---

<LayoutForja pagina="servicios" titulo={p.titulo} descripcion={p.descripcion} conServicios={true}>
  <CabeceraPagina etiqueta={p.etiqueta} lineas={p.h1} entrada={p.entrada} incluye={d.incluye.paginaServicios} foto="servicios" alt={p.altFoto} />

  <!-- Membresías en tarjetas que se comparan -->
  <section id="membresias" class="claro corte pb-20 pt-[calc(var(--corte)+4rem)] lg:pb-28 lg:pt-[calc(var(--corte)+5.5rem)]">
    <div class="contenedor" data-incluye={d.incluye.membresias}>
      <div class="grid grid-cols-1 gap-6 lg:grid-cols-12 lg:items-end">
        <h2 class="titulo-seccion lg:col-span-7">{p.tituloMembresias}</h2>
        <p class="max-w-md text-lg text-grafito lg:col-span-5 lg:justify-self-end">{p.textoMembresias}</p>
      </div>

      <ul class="mt-14 grid grid-cols-1 gap-x-6 gap-y-10 md:grid-cols-2 xl:mt-20 xl:grid-cols-4 xl:gap-x-5">
        {d.membresias.planes.map((m) => (
          <li class:list={['relative flex flex-col border-2 border-negro p-6 lg:p-7 xl:p-6', m.destacada ? 'oscuro shadow-[10px_10px_0_var(--color-negro-3)] xl:-mt-6 xl:pb-12' : 'bg-tiza']}>
            {m.destacada && (
              <p class="absolute -top-4 left-5 -skew-x-12 bg-voltio px-3 py-1.5 text-xs font-semibold uppercase tracking-[0.14em] text-negro">{p.destacada}</p>
            )}
            <h3 class="text-[2.5rem] leading-[0.9] xl:text-[1.9rem]">{m.nombre}</h3>
            <p class:list={['mt-3 min-h-[3.1em]', m.destacada ? 'text-tiza/80' : 'text-grafito']}>{m.resumen}</p>
            <p class="mt-6 flex items-end gap-2">
              <span class:list={['cifra contorno text-[3.6rem] xl:text-[3.4rem]', m.destacada ? 'text-voltio' : 'text-negro']}>
                <span class="align-top text-[0.5em]">{d.comun.abreviaturaPesos}</span>{cifraPesos(m.precio)}
              </span>
              <span class:list={['pb-1.5 text-sm font-semibold', m.destacada ? 'text-tiza/80' : 'text-grafito']}>{d.comun.alMes}</span>
            </p>
            <dl class:list={['mt-6 border-t-2', m.destacada ? 'border-negro-3' : 'border-negro/15']}>
              {filas.map((f, i) => (
                <div class:list={['grid grid-cols-[7.25rem_1fr] gap-3 border-b py-3 xl:grid-cols-1 xl:gap-1', m.destacada ? 'border-negro-3' : 'border-negro/15']}>
                  <dt class:list={['text-[0.8125rem] font-semibold uppercase leading-tight tracking-[0.08em]', m.destacada ? 'text-humo' : 'text-grafito']}>{f}</dt>
                  <dd class="font-semibold leading-tight">{m.valores[i]}</dd>
                </div>
              ))}
            </dl>
            <a
              href={contacto.enlaceWhatsApp}
              target="_blank"
              rel="noopener"
              class:list={['boton boton-chico mt-8 w-full whitespace-normal text-center', m.destacada ? 'boton-voltio' : 'boton-negro']}
            >
              {p.botonPlan}
            </a>
          </li>
        ))}
      </ul>
      <p class="mt-10 max-w-2xl text-sm text-grafito">{p.notaPrecios}</p>
    </div>
  </section>

  <!-- Servicios con precio -->
  <section class="oscuro corte-inverso pb-[calc(var(--corte)+4rem)] pt-[calc(var(--corte)+4rem)] lg:pb-[calc(var(--corte)+6rem)] lg:pt-[calc(var(--corte)+6rem)]">
    <div class="contenedor" data-incluye={d.incluye.servicios}>
      <div class="grid grid-cols-1 gap-6 lg:grid-cols-12 lg:items-end">
        <div class="lg:col-span-7">
          <p class="etiqueta">{rellenar(p.etiquetaServicios, { n: String(d.servicios.reduce((n, g) => n + g.items.length, 0)) })}</p>
          <h2 class="titulo-seccion mt-4">{p.tituloServicios}</h2>
        </div>
        <p class="max-w-md text-lg text-tiza/85 lg:col-span-5 lg:justify-self-end">{p.textoServicios}</p>
      </div>

      <div class="mt-14 gap-x-16 lg:mt-20 lg:columns-2">
        {d.servicios.map((g) => (
          <div class="mb-14 break-inside-avoid">
            <div class="flex items-end justify-between gap-4 border-b-4 border-voltio pb-3">
              <h3 class="text-[2.6rem]">{g.grupo}</h3>
              <span class="cifra contorno text-[3rem] text-voltio" aria-hidden="true">{String(g.items.length).padStart(2, '0')}</span>
            </div>
            <ul>
              {g.items.map((s) => (
                <li class="grid grid-cols-[1fr_auto] items-baseline gap-x-5 border-b border-negro-3 py-4">
                  <div>
                    <p class="text-lg font-semibold leading-snug">{s.nombre}</p>
                    <p class="mt-0.5 text-[0.9375rem] text-humo">{s.detalle}</p>
                  </div>
                  {typeof s.precio === 'number' ? (
                    <p class="cifra text-[1.85rem] text-tiza">{precio(s.precio)}</p>
                  ) : (
                    <p class="-skew-x-12 bg-voltio px-2.5 py-1 font-display text-xl font-extrabold uppercase italic text-negro">{s.precio}</p>
                  )}
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <Llamado titulo={p.dudaTitulo} texto={p.dudaTexto} boton={p.dudaBoton} />
</LayoutForja>
