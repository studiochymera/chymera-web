---
import LayoutForja from '../../../../components/demos/gimnasio/LayoutForja.astro';
import CabeceraPagina from '../../../../components/demos/gimnasio/CabeceraPagina.astro';
import Llamado from '../../../../components/demos/gimnasio/Llamado.astro';
import Imagen from '../../../../base/Imagen.astro';
import { datos as d } from '../../../../components/demos/gimnasio/datos';

const p = d.paginas.nosotros;
---

<LayoutForja pagina="nosotros" titulo={p.titulo} descripcion={p.descripcion}>
  <CabeceraPagina etiqueta={p.etiqueta} lineas={p.h1} entrada={p.entrada} incluye={d.incluye.paginaNosotros} foto="nosotros" alt={p.altFoto} />

  <!-- Historia -->
  <section class="claro corte pb-20 pt-[calc(var(--corte)+4rem)] lg:pb-28 lg:pt-[calc(var(--corte)+6rem)]">
    <div class="contenedor grid grid-cols-1 gap-12 lg:grid-cols-12 lg:gap-10" data-incluye={d.incluye.historia}>
      <div class="lg:col-span-6">
        <p class="etiqueta">{p.historia.etiqueta}</p>
        <h2 class="titulo-seccion mt-4">{p.historia.titulo}</h2>
      </div>
      <div class="grid gap-5 text-lg leading-relaxed text-negro/80 lg:col-span-5 lg:col-start-8 lg:pt-14">
        {p.historia.parrafos.map((t) => <p>{t}</p>)}
      </div>
      <ul class="grid grid-cols-3 border-t-4 border-negro lg:col-span-12">
        {p.historia.cifras.map((c, i) => (
          <li class:list={['pt-5 pr-3', i > 0 && 'border-l-2 border-negro/15 pl-3 sm:pl-6 lg:pl-10']}>
            <span class="cifra contorno block text-[2.6rem] text-negro sm:text-[4rem] lg:text-[6.5rem]">{c.valor}</span>
            <span class="mt-2 block text-[0.9375rem] leading-snug text-grafito">{c.texto}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Método -->
  <section class="oscuro corte-inverso pb-[calc(var(--corte)+4rem)] pt-[calc(var(--corte)+4rem)] lg:pb-[calc(var(--corte)+6rem)] lg:pt-[calc(var(--corte)+6rem)]">
    <div class="contenedor">
      <p class="etiqueta">{p.metodo.etiqueta}</p>
      <h2 class="titulo-seccion mt-4 max-w-4xl">{p.metodo.titulo}</h2>
      <ol class="mt-14 grid grid-cols-1 gap-10 sm:grid-cols-2 lg:mt-20 lg:grid-cols-4 lg:gap-0">
        {p.metodo.pasos.map((x, i) => (
          <li class="group border-t-2 border-negro-3 pt-6 lg:border-l-2 lg:border-t-0 lg:px-7 lg:pt-0 lg:first:border-l-0 lg:first:pl-0">
            <span class="cifra contorno block text-[5rem] text-voltio transition-transform duration-300 group-hover:-translate-y-1 lg:text-[6.5rem]" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="mt-4 text-[2.1rem]">{x.titulo}</h3>
            <p class="mt-3 text-tiza/80">{x.texto}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- Equipo -->
  <section class="claro corte pb-20 pt-[calc(var(--corte)+4rem)] lg:pb-28 lg:pt-[calc(var(--corte)+6rem)]">
    <div class="contenedor" data-incluye={d.incluye.equipo}>
      <div class="grid grid-cols-1 gap-6 lg:grid-cols-12 lg:items-end">
        <div class="lg:col-span-6">
          <p class="etiqueta">{p.equipo.etiqueta}</p>
          <h2 class="titulo-seccion mt-4">{p.equipo.titulo}</h2>
        </div>
        <p class="max-w-md text-lg text-grafito lg:col-span-5 lg:col-start-8">{p.equipo.texto}</p>
      </div>
      <ul class="mt-14 grid grid-cols-2 gap-x-4 gap-y-12 lg:mt-20 lg:grid-cols-3 lg:gap-x-10 lg:gap-y-16">
        {p.equipo.lista.map((c, i) => (
          <li class:list={['foto-viva', i % 3 === 1 && 'lg:mt-16']}>
            <figure>
              <div class="relative mr-1.5 lg:mr-2.5">
                <div class="absolute -bottom-1.5 -right-1.5 h-full w-full bg-negro lg:-bottom-2.5 lg:-right-2.5" aria-hidden="true"></div>
                <div class="relative aspect-[4/5] overflow-hidden">
                  <Imagen
                    ruta={`demos/gimnasio/${c.foto}`}
                    alt={c.alt}
                    proporcion="4/5"
                    sizes="(min-width: 1024px) 30vw, 50vw"
                    anchos={[360, 600, 800]}
                    claseMarco="block h-full w-full"
                    class="foto h-full w-full object-cover"
                  />
                </div>
              </div>
              <figcaption class="mt-5">
                <h3 class="text-[1.6rem] leading-[0.95] sm:text-[2rem] lg:text-[2.4rem]">{c.nombre}</h3>
                <p class="mt-2.5 flex items-baseline gap-2 text-[0.75rem] font-semibold uppercase leading-snug tracking-[0.1em] lg:text-[0.8125rem]">
                  <span class="inline-block h-1.5 w-4 shrink-0 -skew-x-12 bg-negro" aria-hidden="true"></span>{c.rol}
                </p>
                <p class="mt-2.5 text-[0.9375rem] leading-snug text-grafito">{c.certificacion}</p>
              </figcaption>
            </figure>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <Llamado />
</LayoutForja>
