---
// Kit de marca de muestra (Filo Barbería). Es una muestra del portafolio: no se indexa y no va en sitemap.xml.
import '@fontsource/dm-serif-display/latin-400.css';
import '@fontsource-variable/dm-sans/wght.css';
import Base from '../../layouts/Base.astro';
import Encabezado from '../../components/Encabezado.astro';
import Pie from '../../components/Pie.astro';
import BotonWhatsApp from '../../components/BotonWhatsApp.astro';
import Imagen from '../../base/Imagen.astro';
import site from '../../data/site.json';
import { enlaceWhatsApp } from '../../lib/rutas';

const k = site.kitMuestra;
const precio = site.detallePlanes.extras.find((e) => e.nombre.startsWith('Kit de marca'))!.precio;
const kit = 'portafolio/kit-filo/';
---

<Base titulo={`${k.tituloPagina} · ${site.nombre}`} descripcion={k.descripcion} noIndexar>
  <Encabezado />

  <main>
    <!-- Portada -->
    <section class="bg-azul text-crema">
      <div class="contenedor grid gap-10 py-14 sm:py-20 lg:grid-cols-12 lg:items-end">
        <div class="lg:col-span-7">
          <nav aria-label="Ruta" class="text-sm text-crema/70">
            <a href="../../" class="hover:text-crema">Inicio</a>
            <span aria-hidden="true" class="mx-2">/</span>
            <a href="../../#portafolio" class="hover:text-crema">Portafolio</a>
            <span aria-hidden="true" class="mx-2">/</span>
            <span class="text-crema">{k.etiqueta}</span>
          </nav>
          <p class="mt-8 text-sm font-semibold text-celeste">{k.etiqueta}</p>
          <h1 class="mt-2 text-[clamp(2.6rem,1.6rem+4.6vw,5rem)] font-semibold leading-[1.02] tracking-[-0.04em] text-crema">{k.titulo}</h1>
          <p class="mt-5 max-w-xl text-lg text-crema/80 [text-wrap:pretty]">{k.intro}</p>
          <div class="mt-8 flex flex-wrap gap-3">
            <a href={enlaceWhatsApp(site.whatsapp, k.whatsappTexto)} class="boton-claro" target="_blank" rel="noopener">{k.boton}</a>
            <a href="../../demos/barberia/" class="boton-borde">{k.verDemo}</a>
          </div>
        </div>
        <div class="filo-carbon grid aspect-[4/3] place-items-center rounded-2xl lg:col-span-5">
          <img src={`../../${kit}filo-compacto-color-oscuro.svg`} alt="Logo compacto de Filo Barbería en hueso y latón sobre carbón" width="676" height="440" class="w-3/4" />
        </div>
      </div>
    </section>

    <!-- Logo -->
    <section class="py-16 sm:py-24" aria-labelledby="logo-titulo">
      <div class="contenedor">
        <div class="grid gap-3 lg:grid-cols-12">
          <h2 id="logo-titulo" class="titulo lg:col-span-6">{k.logoTitulo}</h2>
          <p class="max-w-md text-tinta/75 lg:col-span-5 lg:col-start-8 lg:self-end">{k.logoTexto}</p>
        </div>
        <div class="mt-10 grid gap-4 md:grid-cols-[1.6fr_1fr_1fr]">
          {k.logos.map((l) => (
            <figure class="flex flex-col">
              <div class:list={['grid aspect-[4/3] place-items-center rounded-xl p-8 md:aspect-auto md:h-64', l.fondo === 'oscuro' ? 'filo-carbon' : 'filo-hueso']}>
                <img src={`../../${kit}${l.archivo}`} alt={`Logo ${l.nombre.toLowerCase()} de Filo Barbería`} loading="lazy" class="max-h-full w-auto max-w-[85%]" />
              </div>
              <figcaption class="mt-3 text-sm"><strong class="font-semibold text-azul">{l.nombre}.</strong> <span class="text-tinta/70">{l.uso}</span></figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>

    <!-- Colores y tipografías -->
    <section class="bg-crema-2 py-16 sm:py-24">
      <div class="contenedor grid gap-14 lg:grid-cols-2">
        <div>
          <h2 class="titulo">{k.coloresTitulo}</h2>
          <ul class="mt-8 grid grid-cols-2 gap-4">
            {k.colores.map((c) => (
              <li>
                <span class="block aspect-[3/2] rounded-lg shadow-[inset_0_0_0_1px_rgb(4_5_7/0.08)]" style={`background:${c.hex}`}></span>
                <p class="mt-2 font-semibold text-azul">{c.nombre}</p>
                <p class="text-sm text-tinta/70 [font-variant-numeric:tabular-nums]">{c.hex}</p>
                <p class="text-sm text-tinta/70">{c.uso}</p>
              </li>
            ))}
          </ul>
        </div>
        <div>
          <h2 class="titulo">{k.tiposTitulo}</h2>
          <div class="mt-8 divide-y divide-azul/15 border-y border-azul/15">
            {k.tipos.map((t) => (
              <div class="py-6">
                <p class="text-sm text-tinta/70">{t.rol}</p>
                <p class:list={['mt-2 text-[#141210]', t.clase === 'serif' ? 'filo-serif text-5xl leading-none sm:text-6xl' : 'filo-sans text-xl font-medium']}>{t.muestra}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- Redes -->
    <section class="py-16 sm:py-24" aria-labelledby="redes-titulo">
      <div class="contenedor">
        <div class="grid gap-3 lg:grid-cols-12">
          <h2 id="redes-titulo" class="titulo lg:col-span-6">{k.redesTitulo}</h2>
          <p class="max-w-md text-tinta/75 lg:col-span-5 lg:col-start-8 lg:self-end">{k.redesTexto}</p>
        </div>
        <div class="mt-10 grid items-center gap-6 md:grid-cols-[1fr_2.6fr]">
          <div class="flex items-center gap-5 md:block">
            <Imagen ruta="portafolio/kit-filo/filo-foto-de-perfil-1080" alt={k.perfilAlt} anchos={[240, 480]} sizes="(min-width: 768px) 240px, 40vw" claseMarco="block w-2/5 md:w-full" class="aspect-square w-full rounded-full" />
            <img src={`../../${kit}filo-favicon.svg`} alt="Favicon de Filo" width="48" height="48" loading="lazy" class="h-12 w-12 rounded-md md:mt-6" />
          </div>
          <Imagen ruta="portafolio/kit-filo/filo-portada-facebook-1640x624" alt={k.portadaAlt} anchos={[640, 960, 1640]} sizes="(min-width: 1024px) 760px, 92vw" class="w-full rounded-xl" />
        </div>
      </div>
    </section>

    <!-- Guía -->
    <section class="bg-azul py-16 text-crema sm:py-24" aria-labelledby="guia-titulo">
      <div class="contenedor grid gap-10 lg:grid-cols-12 lg:items-center">
        <div class="lg:col-span-5">
          <h2 id="guia-titulo" class="titulo text-crema">{k.guiaTitulo}</h2>
          <p class="mt-4 max-w-md text-crema/80 [text-wrap:pretty]">{k.guiaTexto}</p>
          <a href={`../../${kit}filo-guia-de-marca.pdf`} class="boton-claro mt-8" download>{k.guiaDescargar}</a>
        </div>
        <div class="lg:col-span-6 lg:col-start-7">
          <Imagen ruta="portafolio/kit-filo/guia" alt={k.guiaAlt} anchos={[480, 800, 1200]} sizes="(min-width: 1024px) 560px, 92vw" class="w-full rounded-lg shadow-[0_30px_60px_-20px_rgb(0_0_0/0.6)]" />
        </div>
      </div>
    </section>

    <!-- Qué incluye -->
    <section class="py-16 sm:py-24" aria-labelledby="incluye-titulo">
      <div class="contenedor grid gap-10 lg:grid-cols-12">
        <div class="lg:col-span-5">
          <h2 id="incluye-titulo" class="titulo">{k.incluyeTitulo}</h2>
          <p class="mt-4 font-display text-2xl font-semibold text-azul [font-variant-numeric:tabular-nums]">{k.precio.replace('{precio}', precio)}</p>
          <div class="mt-8 flex flex-wrap gap-3">
            <a href={enlaceWhatsApp(site.whatsapp, k.whatsappTexto)} class="boton-azul" target="_blank" rel="noopener">{k.boton}</a>
            <a href="../../planes/" class="boton inline-flex border border-azul/25 text-azul hover:border-azul">{k.verPlanes}</a>
          </div>
        </div>
        <div class="lg:col-span-6 lg:col-start-7">
          <ul class="divide-y divide-azul/15 border-y border-azul/15">
            {k.incluye.map((i) => (
              <li class="flex gap-3 py-4"><span aria-hidden="true" class="text-azul">✓</span><span>{i}</span></li>
            ))}
          </ul>
          <p class="mt-4 text-sm text-tinta/70">{k.noIncluye}</p>
          <p class="mt-8 text-sm text-tinta/60">{k.aviso}</p>
          <a href="../../#portafolio" class="mt-4 inline-block text-sm font-semibold text-azul underline underline-offset-4">{k.volver}</a>
        </div>
      </div>
    </section>
  </main>

  <Pie />
  <BotonWhatsApp texto={k.whatsappTexto} />
</Base>

<style>
  .titulo {
    font-size: clamp(1.9rem, 1.4rem + 2vw, 2.75rem);
    font-weight: 600;
    line-height: 1.08;
    letter-spacing: -0.03em;
    text-wrap: balance;
  }
  .filo-carbon {
    background: #141210;
  }
  .filo-hueso {
    background: #ede6da;
  }
  .filo-serif {
    font-family: 'DM Serif Display', serif;
  }
  .filo-sans {
    font-family: 'DM Sans Variable', 'DM Sans', sans-serif;
  }
</style>
