---
import Base from '../layouts/Base.astro';
import Encabezado from '../components/Encabezado.astro';
import Portada from '../components/Portada.astro';
import Vitrina from '../components/Vitrina.astro';
import Intro from '../components/Intro.astro';
import Pie from '../components/Pie.astro';
import BotonWhatsApp from '../components/BotonWhatsApp.astro';
import site from '../data/site.json';
import { enlaceWhatsApp } from '../lib/rutas';
import Imagen from '../base/Imagen.astro';

const demos = site.demos.lista.map((d) => ({ d, plan: site.paquetes.find((p) => p.slug === d.plan)! }));
const kitPrecio = site.detallePlanes.extras.find((e) => e.nombre.startsWith('Kit de marca'))!.precio;
const s = site.servicios;
const k = site.portafolio.kit;
const kitColores = site.kitMuestra.colores;
const cta = site.ctaSecciones;
const bv = site.beneficiosVisual;
const [b1, b2, b3] = site.beneficios;

const wa = enlaceWhatsApp(site.whatsapp, site.whatsappTexto);
const ig = `https://www.instagram.com/${site.instagram}/`;
const waEspecial = enlaceWhatsApp(site.whatsapp, site.especiales.whatsappTexto);
---

<Base>
  <Intro />
  <Encabezado />

  <main id="inicio">
    <Portada />
    <Vitrina />

    <!-- Lo que hacemos: bento 1 + 2 (una celda grande y dos apiladas) -->
    <section id="servicios" class="seccion" aria-labelledby="servicios-titulo">
      <div class="contenedor">
        <header class="cabecera">
          <h2 id="servicios-titulo" class="titulo-seccion">{s.titulo}</h2>
          <p class="cabecera-texto">{s.intro}</p>
        </header>

        <div class="bento" data-bento>
          <article class="celda celda-web">
            <div class="celda-cuerpo">
              <h3 class="celda-titulo">{s.web.nombre}</h3>
              <p class="celda-texto">{s.web.texto}</p>
              <div class="celda-pie">
                <p class="celda-precio">{s.web.precio}</p>
                <a href="#precios" class="enlace enlace-claro">{s.web.enlace}</a>
              </div>
            </div>
            <div class="abanico" aria-hidden="true">
              {demos.map(({ d }, i) => (
                <span class="abanico-tel" style={`--d:${i - 1}`} data-abanico>
                  <Imagen ruta={`portafolio/${d.slug}`} alt="" anchos={[320, 480, 640]} sizes="(min-width: 1024px) 290px, 62vw" proporcion="390/700" claseMarco="block" class="block w-full" />
                </span>
              ))}
            </div>
          </article>

          <article class="celda celda-kit">
            <a href="portafolio/kit-de-marca/" class="kit-placa" tabindex="-1" aria-hidden="true">
              <img src="portafolio/kit-filo/filo-horizontal-color.svg" alt="" width="1129" height="335" loading="lazy" />
            </a>
            <div class="celda-cuerpo">
              <h3 class="celda-titulo">{s.kit.nombre}</h3>
              <p class="celda-texto">{s.kit.texto}</p>
              <div class="celda-pie">
                <p class="celda-precio">{kitPrecio}</p>
                <a href="portafolio/kit-de-marca/" class="enlace">{s.kit.enlace}</a>
              </div>
            </div>
          </article>

          <article id="especiales" class="celda celda-especiales">
            <div class="celda-cuerpo">
              <h3 class="celda-titulo">{site.especiales.titulo}</h3>
              <p class="celda-texto">{site.especiales.texto}</p>
              <ul class="chips">
                {site.especiales.ejemplos.map((e) => <li>{e}</li>)}
              </ul>
              <div class="celda-pie">
                <a href={waEspecial} class="boton-azul" target="_blank" rel="noopener">{site.especiales.boton}</a>
              </div>
            </div>
          </article>
        </div>
      </div>
    </section>

    <!-- Beneficios y sectores: bento 7/5 y 5/7 -->
    <section class="seccion bg-crema-2" aria-labelledby="beneficios-titulo">
      <div class="contenedor">
        <header class="cabecera">
          <h2 id="beneficios-titulo" class="titulo-seccion">{site.beneficiosTitulo}</h2>
          <div class="cabecera-accion">
            <a href={enlaceWhatsApp(site.whatsapp, cta.beneficios.whatsappTexto)} class="boton-azul" target="_blank" rel="noopener">{cta.beneficios.boton}</a>
          </div>
        </header>

        <div class="bento" data-bento>
          <article class="celda celda-google">
            <div class="busqueda" aria-hidden="true">
              <span class="busqueda-campo">
                <svg viewBox="0 0 24 24" width="18" height="18" focusable="false"><circle cx="10.5" cy="10.5" r="6.5" fill="none" stroke="currentColor" stroke-width="2" /><path d="m15.5 15.5 5 5" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
                {bv.busqueda}
              </span>
              <span class="busqueda-resultado" data-destacado>
                <span class="busqueda-pin"><img src="brand/isotipo-cream.svg" alt="" width="900" height="674" loading="lazy" /></span>
                <span class="busqueda-datos">
                  <strong>{bv.resultado}</strong>
                  <span>{bv.detalle}</span>
                </span>
                <span class="busqueda-acciones">
                  {bv.acciones.map((a) => <span>{a}</span>)}
                </span>
              </span>
              <span class="busqueda-otro"><span></span><span></span></span>
              <span class="busqueda-otro"><span></span><span></span></span>
            </div>
            <div class="celda-cuerpo">
              <h3 class="celda-titulo">{b1.titulo}</h3>
              <p class="celda-texto">{b1.texto}</p>
            </div>
          </article>

          <article class="celda celda-whatsapp">
            <div class="chat" aria-hidden="true">
              <span class="chat-burbuja" data-burbuja>
                {bv.mensaje}
                <span class="chat-hora">{bv.hora} <span class="chat-visto">✓✓</span></span>
              </span>
            </div>
            <div class="celda-cuerpo">
              <h3 class="celda-titulo">{b2.titulo}</h3>
              <p class="celda-texto">{b2.texto}</p>
            </div>
          </article>

          <article class="celda celda-celular">
            <div class="celda-cuerpo">
              <h3 class="celda-titulo">{b3.titulo}</h3>
              <p class="celda-texto">{b3.texto}</p>
            </div>
            <div class="asoma" aria-hidden="true">
              <span class="asoma-tel">
                <Imagen ruta="portafolio/spa" alt="" anchos={[320, 480, 640]} sizes="(min-width: 1024px) 290px, 62vw" proporcion="390/700" claseMarco="block" class="block w-full" />
              </span>
            </div>
          </article>

          <article class="celda celda-sectores">
            <div class="celda-cuerpo">
              <h3 class="celda-titulo">{site.sectoresTitulo}</h3>
              <dl class="sectores">
                {site.sectores.map((x) => (
                  <div>
                    <dt>{x.titulo}</dt>
                    <dd>{x.texto}</dd>
                  </div>
                ))}
              </dl>
            </div>
          </article>
        </div>
      </div>
    </section>

    <!-- Portafolio: bento 7/5 y 5/7 con las tres demos y el Kit de marca -->
    <section id="portafolio" class="seccion bg-azul text-crema" aria-labelledby="portafolio-titulo">
      <div class="contenedor">
        <header class="cabecera cabecera-clara">
          <h2 id="portafolio-titulo" class="titulo-seccion text-crema">{site.portafolio.titulo}</h2>
          <p class="cabecera-texto">{site.portafolio.intro}</p>
        </header>

        <div class="bento" data-bento>
          {demos.map(({ d, plan }) => (
            <article class="celda celda-demo">
              <a href={`demos/${d.slug}/`} class={`escenario escenario-${d.slug}`} tabindex="-1" aria-hidden="true" data-inclinar>
                <span class="telefono" data-inclinar-objeto>
                  <Imagen ruta={`portafolio/${d.slug}`} alt="" anchos={[320, 480, 640]} sizes="(min-width: 1024px) 290px, 62vw" proporcion="390/700" claseMarco="block" class="block w-full" />
                  <span class="brillo"></span>
                </span>
              </a>
              <div class="celda-cuerpo">
                <h3 class="celda-titulo text-crema">{d.nombre}</h3>
                <p class="demo-sector">{d.sector}</p>
                <p class="celda-texto">{d.resumen}</p>
                <p class="demo-muestra">{site.portafolio.muestra}</p>
                <ul class="demo-lista">
                  {d.muestra.map((m) => <li>{m}</li>)}
                </ul>
                <p class="demo-plan">
                  <span>{site.demos.franja.plan.replace('{plan}', plan.nombre)}</span>
                  <span class="demo-precio">${plan.precio}</span>
                </p>
                <div class="celda-pie demo-acciones">
                  <a href={`demos/${d.slug}/`} class="boton-claro">{site.portafolio.verDemo}</a>
                  <a href={`planes/${plan.slug}/`} class="enlace enlace-claro">{site.portafolio.verPlan}</a>
                </div>
              </div>
            </article>
          ))}

          <article class="celda celda-demo celda-kitmuestra" aria-labelledby="kit-titulo">
            <a href="portafolio/kit-de-marca/" class="escenario escenario-kit" tabindex="-1" aria-hidden="true" data-inclinar>
              <span class="kit-lamina" data-inclinar-objeto>
                <span class="kit-hueso">
                  <img src="portafolio/kit-filo/filo-horizontal-color.svg" alt="" width="1129" height="335" loading="lazy" />
                </span>
                <span class="kit-carbon">
                  <img src="portafolio/kit-filo/filo-compacto-color-oscuro.svg" alt="" width="676" height="440" loading="lazy" />
                </span>
                <span class="kit-icono">
                  <img src="portafolio/kit-filo/filo-icono-color.svg" alt="" width="485" height="485" loading="lazy" />
                </span>
                <span class="kit-colores">
                  {kitColores.map((c) => <span style={`background:${c.hex}`}></span>)}
                </span>
                <span class="brillo"></span>
              </span>
            </a>
            <div class="celda-cuerpo">
              <h3 id="kit-titulo" class="celda-titulo text-crema">{k.titulo}</h3>
              <p class="celda-texto">{k.texto}</p>
              <p class="demo-muestra">{k.incluyeTitulo}</p>
              <ul class="demo-lista">
                {k.incluye.map((m) => <li>{m}</li>)}
              </ul>
              <p class="demo-plan">
                <span>{s.kit.nombre}</span>
                <span class="demo-precio">{kitPrecio}</span>
              </p>
              <div class="celda-pie demo-acciones">
                <a href="portafolio/kit-de-marca/" class="boton-claro">{k.ver}</a>
              </div>
            </div>
          </article>
        </div>

        <p class="mt-6 text-sm text-crema/60">{site.portafolio.aviso}</p>
      </div>
    </section>

    <!-- Precios -->
    <section id="precios" class="bg-crema-2 py-16 sm:py-24">
      <div class="contenedor">
        <h2 class="titulo-seccion">{site.precios.titulo}</h2>
        <p class="mt-3 max-w-2xl text-tinta/75">{site.precios.intro}</p>

        <div class="mt-10 grid gap-5 lg:grid-cols-3">
          {site.paquetes.map((p) => (
            <article class:list={[
              'flex flex-col rounded-2xl p-7',
              p.destacado ? 'border border-transparent bg-azul text-crema ring-2 ring-celeste' : 'border border-azul/10 bg-crema',
            ]}>
              <div class="flex items-center justify-between">
                <h3 class:list={['text-2xl font-semibold', p.destacado && 'text-crema']}>{p.nombre}</h3>
                {p.destacado && <span class="rounded-full bg-celeste px-3 py-1 text-xs font-semibold text-azul">Más elegido</span>}
              </div>
              <p class:list={['mt-2 text-sm', p.destacado ? 'text-crema/75' : 'text-tinta/70']}>{p.resumen}</p>
              <p class="mt-6 [font-variant-numeric:tabular-nums]">
                <span class="font-display text-4xl font-semibold tracking-tight">${p.precio}</span>
                <span class:list={['ml-1 text-sm', p.destacado ? 'text-crema/70' : 'text-tinta/60']}>COP</span>
              </p>
              <p class:list={['text-sm [font-variant-numeric:tabular-nums]', p.destacado ? 'text-crema/75' : 'text-tinta/70']}>+ ${p.mensual} al mes</p>
              <ul class="mt-6 space-y-2 text-sm">
                {p.incluye.map((item) => (
                  <li class="flex gap-2">
                    <span aria-hidden="true" class:list={[p.destacado ? 'text-celeste' : 'text-azul']}>✓</span>
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
              <div class="mt-auto flex flex-col gap-3 pt-8">
                <a href={enlaceWhatsApp(site.whatsapp, site.detallePlanes.whatsappPlan.replace('{plan}', p.nombre))} target="_blank" rel="noopener" class:list={[p.destacado ? 'boton-claro' : 'boton-azul']}>Quiero {p.nombre}</a>
                <a href={`planes/${p.slug}/`} class:list={['text-center text-sm font-semibold underline underline-offset-4', p.destacado ? 'text-crema hover:text-celeste' : 'text-azul hover:text-azul-2']}>{site.detallePlanes.verDetalle}</a>
              </div>
            </article>
          ))}
        </div>

        <div class="mt-10 grid gap-5 md:grid-cols-2">
          {site.planes.map((pl) => (
            <div class="rounded-2xl border border-azul/10 bg-crema p-6">
              <p class="font-display text-lg font-semibold text-azul [font-variant-numeric:tabular-nums]">Plan {pl.nombre} · ${pl.precio} al mes</p>
              <p class="mt-2 text-sm text-tinta/75">{pl.texto}</p>
            </div>
          ))}
        </div>

        <p class="mt-8 text-center">
          <a href="planes/" class="boton-azul">{site.detallePlanes.comparar}</a>
        </p>
      </div>
    </section>

    <!-- Proceso -->
    <section id="proceso" class="bg-azul py-16 text-crema sm:py-24" aria-labelledby="proceso-titulo">
      <div class="contenedor">
        <div class="flex flex-col items-start justify-between gap-6 md:flex-row md:items-end">
          <h2 id="proceso-titulo" class="titulo-seccion text-crema">{site.procesoTitulo}</h2>
          <a href={enlaceWhatsApp(site.whatsapp, cta.proceso.whatsappTexto)} class="boton-claro" target="_blank" rel="noopener">{cta.proceso.boton}</a>
        </div>
        <ol class="proceso mt-12">
          {site.proceso.map((paso, i) => (
            <li class="paso">
              <span class="paso-numero" aria-hidden="true">{i + 1}</span>
              <h3 class="text-lg font-semibold text-crema">{paso.titulo}</h3>
              <p class="mt-2 text-sm text-crema/75 [text-wrap:pretty]">{paso.texto}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- Preguntas -->
    <section id="preguntas" class="py-16 sm:py-24">
      <div class="contenedor grid gap-10 lg:grid-cols-12">
        <div class="lg:col-span-4">
          <h2 class="titulo-seccion">Preguntas frecuentes</h2>
          <a href={enlaceWhatsApp(site.whatsapp, cta.preguntas.whatsappTexto)} class="boton-azul mt-8" target="_blank" rel="noopener">{cta.preguntas.boton}</a>
        </div>
        <div class="divide-y divide-azul/10 border-y border-azul/10 lg:col-span-7 lg:col-start-6">
          {site.preguntas.map((q) => (
            <details class="group py-5">
              <summary class="flex min-h-11 cursor-pointer list-none items-center justify-between gap-4 font-display font-semibold text-azul [&::-webkit-details-marker]:hidden">
                {q.p}
                <span class="text-xl text-azul/60 transition-transform duration-200 group-open:rotate-45" aria-hidden="true">+</span>
              </summary>
              <p class="mt-3 text-tinta/75">{q.r}</p>
              {'enlace' in q && (
                <a href={q.enlace.href} class="mt-3 inline-block font-medium text-azul underline underline-offset-4 hover:text-tinta">{q.enlace.texto}</a>
              )}
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- Contacto: cierre con la quimera en relieve sobre papel azul -->
    <section id="contacto" class="contacto bg-azul text-crema">
      <div class="contacto-relieve" aria-hidden="true">
        <Imagen ruta="marca/relieve" alt="" anchos={[640, 960, 1280]} sizes="(min-width: 768px) 70vw, 100vw" proporcion="1600/1339" claseMarco="block h-full" class="h-full w-full object-cover" />
      </div>
      <div class="contenedor relative py-20 sm:py-28">
        <h2 class="contacto-titulo">{site.contacto.titulo}</h2>
        <div class="mt-10 grid gap-8 md:grid-cols-12 md:items-end">
          <p class="max-w-md text-lg text-crema/80 md:col-span-5">{site.contacto.texto}</p>
          <div class="flex flex-wrap gap-3 md:col-span-7 md:justify-end">
            <a href={wa} class="boton-claro" target="_blank" rel="noopener">{site.contacto.boton}</a>
            <a href={`mailto:${site.correo}`} class="boton-borde">{site.correo}</a>
            <a href={ig} class="boton-borde" target="_blank" rel="noopener">@{site.instagram}</a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Pie />

  <BotonWhatsApp />
</Base>

<script>
  import '../scripts/movimiento';
</script>

<style>
  .titulo-seccion {
    font-size: clamp(2rem, 1.4rem + 2.6vw, 3.25rem);
    font-weight: 600;
    line-height: 1.06;
    letter-spacing: -0.035em;
    text-wrap: balance;
  }

  .seccion {
    padding-block: clamp(4rem, 2.5rem + 5vw, 7rem);
  }

  /* Cabecera de sección: título a la izquierda, texto o botón a la derecha. */
  .cabecera {
    display: grid;
    gap: 1rem 1.5rem;
    margin-bottom: clamp(2rem, 1.5rem + 2vw, 3.25rem);
  }
  .cabecera-texto {
    max-width: 34rem;
    color: rgb(4 5 7 / 0.75);
    text-wrap: pretty;
  }
  .cabecera-clara .cabecera-texto {
    color: rgb(253 248 244 / 0.75);
  }
  @media (min-width: 1024px) {
    .cabecera {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      align-items: end;
    }
    .cabecera > :first-child {
      grid-column: span 7;
    }
    .cabecera-texto,
    .cabecera-accion {
      grid-column: 8 / span 5;
    }
    .cabecera-accion {
      justify-self: end;
    }
  }

  /* Bento: celdas asimétricas, tantas como piezas de contenido. */
  .bento {
    display: grid;
    gap: 0.75rem;
  }
  @media (min-width: 768px) {
    .bento {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      gap: 1rem;
    }
    .bento > :nth-child(4n + 1),
    .bento > :nth-child(4n + 4) {
      grid-column: span 7;
    }
    .bento > :nth-child(4n + 2),
    .bento > :nth-child(4n + 3) {
      grid-column: span 5;
    }
    .bento > .celda-web {
      grid-row: span 2;
    }
  }

  .celda {
    position: relative;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border-radius: 1.75rem;
    background: var(--color-crema);
    box-shadow: inset 0 0 0 1px rgb(29 42 58 / 0.1);
  }
  .celda-cuerpo {
    display: flex;
    flex: 1;
    flex-direction: column;
    padding: clamp(1.5rem, 1.1rem + 1.2vw, 2.25rem);
  }
  .celda-titulo {
    font-size: clamp(1.5rem, 1.15rem + 1.1vw, 2.1rem);
    font-weight: 600;
    line-height: 1.1;
    letter-spacing: -0.03em;
  }
  .celda-texto {
    max-width: 34rem;
    margin-top: 0.75rem;
    color: rgb(4 5 7 / 0.75);
    text-wrap: pretty;
  }
  .celda-pie {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.25rem;
    margin-top: auto;
    padding-top: 1.75rem;
  }
  .celda-precio {
    font-family: var(--font-display);
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--color-azul);
    font-variant-numeric: tabular-nums;
  }

  /* Celdas oscuras */
  .celda-web,
  .celda-whatsapp,
  .celda-celular {
    background: var(--color-azul);
    color: var(--color-crema);
    box-shadow: none;
  }
  .celda-web .celda-titulo,
  .celda-whatsapp .celda-titulo,
  .celda-celular .celda-titulo,
  .celda-web .celda-precio {
    color: var(--color-crema);
  }
  .celda-web .celda-texto,
  .celda-whatsapp .celda-texto,
  .celda-celular .celda-texto {
    color: rgb(253 248 244 / 0.75);
  }

  .enlace {
    font-weight: 600;
    color: var(--color-azul);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.3em;
    transition: color 150ms ease, text-decoration-color 150ms ease;
  }
  .enlace:hover {
    color: var(--color-tinta);
  }
  .enlace-claro {
    color: var(--color-crema);
    text-decoration-color: var(--color-celeste);
  }
  .enlace-claro:hover {
    color: var(--color-celeste);
  }

  /* Páginas web: las tres demos en abanico, asomando por el borde de la celda. */
  .celda-web {
    min-height: 34rem;
  }
  .celda-web .celda-cuerpo {
    flex: none;
  }
  .abanico {
    position: relative;
    flex: 1;
    min-height: 19rem;
  }
  .abanico-tel {
    --ancho: clamp(9.5rem, 2rem + 20vw, 19rem);
    position: absolute;
    left: 50%;
    top: clamp(1rem, 0.5rem + 3vw, 3.5rem);
    z-index: calc(2 - var(--d) * var(--d));
    width: var(--ancho);
