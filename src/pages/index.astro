---
// Portada de Chymera con la marca Ensamble: todo el sitio está hecho con las tres piezas del símbolo
// (dos cuartos de círculo y un triángulo). Gesto protagonista: las piezas se arman y se desarman
// (src/scripts/mesa.ts). Textos en site.json (claves hero, inicio y las de siempre).
import Base from '../layouts/Base.astro';
import Encabezado from '../components/Encabezado.astro';
import Mesa from '../components/Mesa.astro';
import Pie from '../components/Pie.astro';
import BotonWhatsApp from '../components/BotonWhatsApp.astro';
import Imagen from '../base/Imagen.astro';
import site from '../data/site.json';
import { enlaceWhatsApp } from '../lib/rutas';

const h = site.hero;
const ini = site.inicio;
const e = ini.ensamble;
const pr = ini.precios;
const kitPrecio = site.detallePlanes.extras.find((x) => x.nombre.startsWith('Kit de marca'))!.precio;
const demos = site.demos.lista.map((d) => ({ d, plan: site.paquetes.find((p) => p.slug === d.plan)! }));
const k = site.portafolio.kit;
const cta = site.ctaSecciones;
const wa = enlaceWhatsApp(site.whatsapp, site.whatsappTexto);
const waEspecial = enlaceWhatsApp(site.whatsapp, site.especiales.whatsappTexto);
const waTaller = enlaceWhatsApp(site.whatsapp, ini.taller.whatsappTexto);
const rellenar = (t: string) => t.replace('{kit}', kitPrecio).replace('{desde}', site.servicios.web.precio);
const formasDemo = ['cuarto', 'triangulo', 'circulo'];
---

<Base>
  <a href="#contenido" class="saltar">Saltar al contenido</a>
  <Encabezado />

  <main id="inicio">
    <!-- Portada: titular a la izquierda, la mesa de piezas a la derecha (abajo en celular). -->
    <section class="portada" aria-labelledby="portada-titulo" id="contenido">
      <div class="contenedor portada-reticula">
        <div class="portada-texto">
          <p class="portada-etiqueta">
            <svg viewBox="0 0 92 92" width="14" height="14" aria-hidden="true"><path fill="currentColor" d="M44 0A44 44 0 0 0 0 44H44Z"/><path fill="currentColor" d="M0 48H44V92A44 44 0 0 1 0 48Z"/><path fill="#FCC931" d="M48 0H92L48 44Z"/></svg>
            {h.etiqueta}
          </p>
          <h1 id="portada-titulo" class="portada-titulo">{h.titulo}</h1>
          <p class="portada-sub">{h.subtitulo}</p>
          <div class="portada-botones">
            <a href={wa} class="boton-maiz boton-grande" target="_blank" rel="noopener">{h.boton}</a>
            <a href="#portafolio" class="boton-linea">{h.botonDemos}</a>
          </div>
          <p class="portada-kit">{h.kit} <a href="portafolio/kit-de-marca/">{h.kitEnlace}</a></p>
        </div>
        <div class="portada-mesa">
          <div class="tapete" aria-hidden="true">
            <span class="tapete-regla tapete-regla-x">{Array.from({ length: 12 }, (_, i) => <span>{i + 1}</span>)}</span>
            <span class="tapete-regla tapete-regla-y">{'ABCDEFGHIJKL'.split('').map((l) => <span>{l}</span>)}</span>
          </div>
          <Mesa tipo="portada" etiqueta={ini.portada.mesa} boton={{ armar: ini.portada.armar, desarmar: ini.portada.desarmar }} class="portada-mesa-piezas">
            <p class="portada-pista" aria-hidden="true">{ini.portada.pista}</p>
          </Mesa>
        </div>
      </div>
    </section>

    <!-- Marquesina de sectores: la lista real va una vez; la copia que da la vuelta está oculta para lectores. -->
    <section class="marquesina" aria-label={ini.marquesinaEtiqueta}>
      <div class="marquesina-pista">
        {[0, 1].map((copia) => (
          <ul class="marquesina-lista" aria-hidden={copia === 1 ? 'true' : undefined}>
            {ini.marquesina.map((s, i) => (
              <li>
                <span class:list={['marquesina-pieza', `pieza-${i % 3}`]} aria-hidden="true"></span>
                {s}
              </li>
            ))}
          </ul>
        ))}
      </div>
    </section>

    <!-- Recorrido: la mesa se queda quieta y las piezas cambian de forma con cada paso. -->
    <section id="servicios" class="recorrido" data-recorrido aria-labelledby="recorrido-titulo">
      <div class="contenedor">
        <header class="recorrido-cabecera">
          <h2 id="recorrido-titulo" class="titulo-grande">{e.titulo}</h2>
          <p>{e.intro}</p>
        </header>
        <div class="recorrido-reticula">
          <div class="recorrido-mesa">
            <div class="recorrido-mesa-pegada">
              <Mesa tipo="recorrido" etiqueta={e.mesa} fondo="oscuro" inicial="marca" />
              <ol class="recorrido-marcas" aria-hidden="true">
                {e.pasos.map((p) => <li data-marca-paso={p.id}><span>{p.titulo}</span></li>)}
              </ol>
            </div>
          </div>
          <ol class="recorrido-pasos">
            {e.pasos.map((p, i) => (
              <li class="paso" data-paso={p.id}>
                <span class="paso-numero" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                <h3 class="paso-titulo">{p.titulo}</h3>
                <p class="paso-texto">{p.texto}</p>
                {(p.etiqueta || p.enlace || p.boton) && (
                  <div class="paso-pie">
                    {p.etiqueta && <span class="paso-etiqueta">{rellenar(p.etiqueta)}</span>}
                    {p.enlace && <a class="enlace-claro" href={p.enlace.href}>{p.enlace.texto}</a>}
                    {p.boton && <a class="boton-maiz" href={enlaceWhatsApp(site.whatsapp, cta.beneficios.whatsappTexto)} target="_blank" rel="noopener">{p.boton}</a>}
                  </div>
                )}
              </li>
            ))}
          </ol>
        </div>
      </div>
    </section>

    <!-- Portafolio: cada demo sobre una pieza grande, alternando lados. -->
    <section id="portafolio" class="portafolio" aria-labelledby="portafolio-titulo">
      <div class="contenedor">
        <header class="cabecera">
          <h2 id="portafolio-titulo" class="titulo-grande">{site.portafolio.titulo}</h2>
          <p>{site.portafolio.intro}</p>
        </header>
        <div class="demos">
          {demos.map(({ d, plan }, i) => (
            <article class:list={['demo', i % 2 === 1 && 'demo-invertida']}>
              <a href={`demos/${d.slug}/`} class="demo-escena" tabindex="-1" aria-hidden="true">
                <span class:list={['demo-forma', `forma-${formasDemo[i]}`]}></span>
                <span class="demo-celular">
                  <Imagen ruta={`portafolio/${d.slug}`} alt="" anchos={[320, 480, 640]} sizes="(min-width: 1024px) 300px, 62vw" proporcion="390/700" claseMarco="block" class="block w-full" />
                </span>
              </a>
              <div class="demo-cuerpo">
                <p class="demo-plan">
                  <span>{site.demos.franja.plan.replace('{plan}', plan.nombre)}</span>
                  <span class="demo-precio">${plan.precio}</span>
                </p>
                <h3 class="demo-nombre">{d.nombre}</h3>
                <p class="demo-sector">{d.sector}</p>
                <p class="demo-resumen">{d.resumen}</p>
                <ul class="lista-piezas">
                  {d.muestra.map((m) => <li>{m}</li>)}
                </ul>
                <div class="demo-acciones">
                  <a href={`demos/${d.slug}/`} class="boton-medianoche">{site.portafolio.verDemo}</a>
                  <a href={`planes/${plan.slug}/`} class="enlace">{site.portafolio.verPlan}</a>
                </div>
              </div>
            </article>
          ))}
        </div>

        <article class="kit" aria-labelledby="kit-titulo">
          <a href="portafolio/kit-de-marca/" class="kit-lamina" tabindex="-1" aria-hidden="true">
            <span class="kit-hueso"><img src="portafolio/kit-filo/filo-horizontal-color.svg" alt="" width="1129" height="335" loading="lazy" /></span>
            <span class="kit-carbon"><img src="portafolio/kit-filo/filo-compacto-color-oscuro.svg" alt="" width="676" height="440" loading="lazy" /></span>
            <span class="kit-colores">{site.kitMuestra.colores.map((c) => <span style={`background:${c.hex}`}></span>)}</span>
          </a>
          <div class="kit-cuerpo">
            <p class="kit-etiqueta">{k.etiqueta}</p>
            <h3 id="kit-titulo" class="kit-titulo">{k.titulo}</h3>
            <p>{k.texto}</p>
            <ul class="lista-piezas lista-clara">
              {k.incluye.map((m) => <li>{m}</li>)}
            </ul>
            <p class="kit-precio">{k.precio.replace('{precio}', kitPrecio)}</p>
            <a href="portafolio/kit-de-marca/" class="boton-maiz">{k.ver}</a>
          </div>
        </article>
        <p class="aviso">{site.portafolio.aviso}</p>
      </div>
    </section>

    <!-- Precios: cada plan suma una pieza del símbolo. -->
    <section id="precios" class="precios" aria-labelledby="precios-titulo">
      <div class="contenedor">
        <header class="cabecera">
          <h2 id="precios-titulo" class="titulo-grande">{site.precios.titulo}</h2>
          <p>{site.precios.intro}</p>
        </header>
        <div class="fichas">
          {site.paquetes.map((p, i) => {
            const mensual = site.planes.find((m) => m.nombre === p.planMensual)!;
            return (
              <article class:list={['ficha', p.destacado && 'ficha-destacada']} aria-labelledby={`ficha-${p.slug}`}>
                {p.destacado && <p class="ficha-sello">{pr.recomendado}</p>}
                <svg class="ficha-piezas" viewBox="0 0 92 92" width="64" height="64" role="img" aria-label={pr.piezas[i]}>
                  <path d="M44 0A44 44 0 0 0 0 44H44Z" class="lleno" />
                  <path d="M0 48H44V92A44 44 0 0 1 0 48Z" class:list={[i >= 1 ? 'lleno' : 'vacio']} />
                  <path d="M48 0H92L48 44Z" class:list={[i >= 2 ? 'lleno acento' : 'vacio']} />
                </svg>
                <h3 id={`ficha-${p.slug}`} class="ficha-nombre">{p.nombre}</h3>
                <p class="ficha-resumen">{p.resumen}</p>
                <p class="ficha-precio"><span class="ficha-signo">$</span>{p.precio}</p>
                <p class="ficha-unico">{pr.unico}</p>
                <p class="ficha-mensual">{pr.mensual.replace('{mensual}', mensual.precio).replace('{plan}', mensual.nombre)}</p>
                <ul class="ficha-lista">
                  {p.incluye.map((x) => <li>{x}</li>)}
                </ul>
                <div class="ficha-acciones">
                  <a href={enlaceWhatsApp(site.whatsapp, site.detallePlanes.whatsappPlan.replace('{plan}', p.nombre))} class:list={[p.destacado ? 'boton-maiz' : 'boton-medianoche']} target="_blank" rel="noopener">{pr.pedir}</a>
                  <a href={`planes/${p.slug}/`} class="enlace">{pr.ver}</a>
                </div>
              </article>
            );
          })}
        </div>

        <div class="mensuales" id="mensuales">
          <div class="mensuales-texto">
            <h3 class="subtitulo">{pr.mensualesTitulo}</h3>
            <p>{pr.mensualesTexto}</p>
          </div>
          {site.planes.map((m) => (
            <div class="mensual">
              <p class="mensual-nombre">{m.nombre}</p>
              <p class="mensual-precio">${m.precio} <span>{pr.alMes}</span></p>
              <p class="mensual-texto">{m.texto}</p>
            </div>
          ))}
        </div>

        <div class="extras">
          <div>
            <h3 class="subtitulo">{pr.extrasTitulo}</h3>
            <p>{pr.extrasTexto} <strong>{kitPrecio}</strong>.</p>
          </div>
          <div>
            <h3 class="subtitulo">{site.especiales.titulo}</h3>
            <p>{site.especiales.texto}</p>
            <a href={waEspecial} class="enlace" target="_blank" rel="noopener">{site.especiales.boton}</a>
          </div>
        </div>
      </div>
    </section>

    <!-- Proceso: una pieza rueda por la línea mientras se baja por la sección. -->
    <section id="proceso" class="proceso" aria-labelledby="proceso-titulo">
      <div class="contenedor">
        <header class="cabecera cabecera-clara">
          <h2 id="proceso-titulo" class="titulo-grande">{site.procesoTitulo}</h2>
          <p>{ini.proceso.intro}</p>
        </header>
        <div class="proceso-pista">
          <span class="proceso-linea" aria-hidden="true"><span class="proceso-rueda"></span></span>
          <ol class="proceso-pasos">
            {site.proceso.map((p, i) => (
              <li class="proceso-paso">
                <span class="proceso-numero" aria-hidden="true">{i + 1}</span>
                <h3>{p.titulo}</h3>
                <p>{p.texto}</p>
              </li>
            ))}
          </ol>
        </div>
        <a href={enlaceWhatsApp(site.whatsapp, cta.proceso.whatsappTexto)} class="boton-maiz" target="_blank" rel="noopener">{cta.proceso.boton}</a>
      </div>
    </section>

    <!-- Taller: un tablero de 3 x 3 para jugar a armar un logo. -->
    <section class="taller" aria-labelledby="taller-titulo" data-taller data-casilla={ini.taller.casilla} data-formas={JSON.stringify(ini.taller.formas)}>
      <div class="contenedor taller-reticula">
        <div class="taller-texto">
          <h2 id="taller-titulo" class="titulo-grande">{ini.taller.titulo}</h2>
          <p>{ini.taller.texto}</p>
          <fieldset class="taller-colores">
            <legend>{ini.taller.color}</legend>
            {ini.taller.colores.map((c, i) => (
              <label class="taller-color">
                <input type="radio" name="taller-color" value={c.hex} checked={i === 0} />
                <span style={`--c:${c.hex}`}></span>
                {c.nombre}
              </label>
            ))}
          </fieldset>
          <div class="taller-botones">
            <button type="button" class="boton-linea" data-taller-mezclar>{ini.taller.mezclar}</button>
            <button type="button" class="boton-linea" data-taller-limpiar>{ini.taller.limpiar}</button>
          </div>
        </div>
        <div class="taller-mesa">
          <div class="taller-tablero" role="group" aria-label={ini.taller.tablero} data-taller-tablero>
            {Array.from({ length: 9 }, (_, i) => (
              <button type="button" class="casilla" data-casilla={i} aria-label={ini.taller.casilla.replace('{n}', String(i + 1)).replace('{forma}', ini.taller.formas.vacia)}>
                <svg viewBox="0 0 12 12" aria-hidden="true"><path d="" /></svg>
              </button>
            ))}
          </div>
          <div class="taller-perfil">
            <span class="taller-avatar" data-taller-avatar aria-hidden="true"></span>
            <p>{ini.taller.perfil}</p>
          </div>
          <a href={waTaller} class="boton-maiz" target="_blank" rel="noopener">{ini.taller.boton}</a>
        </div>
      </div>
    </section>

    <!-- Preguntas -->
    <section id="preguntas" class="preguntas" aria-labelledby="preguntas-titulo">
      <div class="contenedor preguntas-reticula">
        <div class="preguntas-cabecera">
          <h2 id="preguntas-titulo" class="titulo-grande">Preguntas frecuentes</h2>
          <a href={enlaceWhatsApp(site.whatsapp, cta.preguntas.whatsappTexto)} class="boton-medianoche" target="_blank" rel="noopener">{cta.preguntas.boton}</a>
        </div>
        <div class="preguntas-lista">
          {site.preguntas.map((q) => (
            <details class="pregunta">
              <summary>
                <span>{q.p}</span>
                <svg viewBox="0 0 12 12" width="18" height="18" aria-hidden="true"><path d="M0 0H12L0 12Z" fill="currentColor" /></svg>
              </summary>
              <div class="pregunta-respuesta">
                <p>{q.r} {q.enlace && <a href={q.enlace.href} class="enlace">{q.enlace.texto}</a>}</p>
              </div>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- Cierre -->
    <section id="contacto" class="contacto" aria-labelledby="contacto-titulo">
      <div class="contacto-piezas" aria-hidden="true">
        <span class="cp cp-1"></span><span class="cp cp-2"></span><span class="cp cp-3"></span>
      </div>
      <div class="contenedor contacto-cuerpo">
        <h2 id="contacto-titulo" class="contacto-titulo">{site.contacto.titulo}</h2>
        <p class="contacto-texto">{site.contacto.texto}</p>
        <a href={wa} class="boton-maiz boton-grande" target="_blank" rel="noopener">{site.contacto.boton}</a>
      </div>
    </section>
  </main>

  <Pie />
  <BotonWhatsApp />
</Base>

<script>
  import '../scripts/pagina';
  import '../scripts/mesa';
  import '../scripts/taller';
</script>

<style>
  /* ---------- Base de la página ---------- */
  .saltar {
    position: absolute;
    left: 1rem;
    top: -3rem;
    z-index: 60;
    padding: 0.75rem 1rem;
    border-radius: 0.5rem;
    background: var(--color-medianoche);
    color: var(--color-papel);
    font-weight: 600;
  }
  .saltar:focus {
    top: 1rem;
  }
  :global(html) {
    scroll-padding-top: 5rem;
  }
  .titulo-grande {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(2.25rem, 1.4rem + 3.8vw, 4.75rem);
    line-height: 1;
    letter-spacing: -0.04em;
    font-variation-settings: 'opsz' 96;
    text-wrap: balance;
  }
  .cabecera {
    display: grid;
    gap: 1.25rem;
    margin-bottom: clamp(2.5rem, 6vw, 4.5rem);
  }
  .cabecera p {
    max-width: 58ch;
    font-size: 1.125rem;
    line-height: 1.6;
    color: color-mix(in oklab, var(--color-tinta) 78%, transparent);
    text-wrap: pretty;
  }
  @media (min-width: 1024px) {
    .cabecera {
      grid-template-columns: 7fr 5fr;
      align-items: end;
      gap: 3rem;
    }
  }
  .cabecera-clara p {
    color: color-mix(in oklab, var(--color-papel) 78%, transparent);
  }
  .subtitulo {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.375rem;
    letter-spacing: -0.02em;
    color: var(--color-medianoche);
  }

  /* Botones de la página (los de la marca viven en global.css). */
  .boton-grande {
    min-height: 3.5rem;
    padding-inline: 1.75rem;
    font-size: 1rem;
  }
  .boton-linea,
  .boton-medianoche {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    border-radius: 999px;
    padding: 0.75rem 1.5rem;
    font-size: 0.9375rem;
    font-weight: 600;
    transition: background-color 160ms cubic-bezier(0.2, 0.7, 0.2, 1), color 160ms cubic-bezier(0.2, 0.7, 0.2, 1), transform 160ms cubic-bezier(0.2, 0.7, 0.2, 1);
    cursor: pointer;
  }
  .boton-linea {
    border: 1.5px solid var(--color-medianoche);
    color: var(--color-medianoche);
    background: transparent;
  }
  .boton-linea:hover {
    background: var(--color-medianoche);
    color: var(--color-papel);
  }
  .boton-medianoche {
    background: var(--color-medianoche);
    color: var(--color-papel);
  }
  .boton-medianoche:hover {
    background: var(--color-medianoche-2);
  }
  .boton-linea:active,
  .boton-medianoche:active {
    transform: scale(0.98);
  }
  .enlace,
  .enlace-claro {
    font-weight: 600;
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 5px;
    text-decoration-color: var(--color-maiz);
    transition: text-decoration-color 160ms, text-underline-offset 160ms;
  }
  .enlace {
    color: var(--color-medianoche);
  }
  .enlace-claro {
    color: var(--color-papel);
  }
  .enlace:hover,
  .enlace-claro:hover {
    text-underline-offset: 7px;
  }
  /* Área de toque de 44 px sin mover el diseño (fuera de los párrafos). */
  :is(.enlace, .enlace-claro):not(p *) {
    display: inline-block;
    padding-block: 10px;
    margin-block: -10px;
  }
  .lista-piezas {
    display: grid;
    gap: 0.5rem;
  }
  .lista-piezas li {
    display: flex;
    gap: 0.75rem;
    align-items: baseline;
  }
  .lista-piezas li::before {
    content: '';
    flex: none;
    width: 0.625rem;
    height: 0.625rem;
    background: var(--color-maiz);
    clip-path: polygon(0 0, 100% 0, 0 100%);
    transform: translateY(0.05rem);
  }

  /* ---------- Portada ---------- */
  .portada {
    position: relative;
    overflow: clip;
  }
  .portada-reticula {
    display: grid;
    gap: 2.5rem;
    padding-block: 2rem 3.5rem;
  }
  @media (min-width: 1024px) {
    .portada-reticula {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      align-items: center;
      gap: 1.5rem;
      min-height: min(54rem, calc(100svh - 4rem));
      padding-block: 3rem;
    }
    .portada-texto {
      grid-column: 1 / span 7;
      position: relative;
      z-index: 2;
    }
    .portada-mesa {
      grid-column: 8 / span 5;
    }
  }
  .portada-etiqueta {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-medianoche);
  }
  .portada-titulo {
    margin-top: 1.25rem;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(2.875rem, 1.6rem + 5.6vw, 6.25rem);
    line-height: 0.94;
    letter-spacing: -0.05em;
    color: var(--color-medianoche);
    max-width: 12ch;
    text-wrap: balance;
  }
  .portada-sub {
    margin-top: 1.5rem;
    max-width: 46ch;
    font-size: clamp(1.0625rem, 1rem + 0.3vw, 1.25rem);
    line-height: 1.55;
    color: color-mix(in oklab, var(--color-tinta) 80%, transparent);
    text-wrap: pretty;
  }
  .portada-botones {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }
  .portada-kit {
    margin-top: 1.5rem;
    font-size: 0.9375rem;
    color: color-mix(in oklab, var(--color-tinta) 72%, transparent);
  }
  .portada-kit a {
    font-weight: 600;
    color: var(--color-medianoche);
    text-decoration: underline;
    text-decoration-color: var(--color-maiz);
    text-decoration-thickness: 2px;
    text-underline-offset: 4px;
  }
  .portada-mesa {
    position: relative;
    width: min(100%, 34rem);
    justify-self: center;
    padding: 1.5rem 0 0 1.5rem;
  }
  /* Tapete de corte: la retícula de 12 x 12 donde se arman las piezas, con su regla. */
  .tapete {
    position: absolute;
    inset: 1.5rem 0 0 1.5rem;
    aspect-ratio: 1;
    border-radius: 0.75rem;
    background-color: #EEEFE8;
    background-image:
      linear-gradient(to right, rgb(20 33 61 / 0.08) 1px, transparent 1px),
      linear-gradient(to bottom, rgb(20 33 61 / 0.08) 1px, transparent 1px);
    background-size: calc(100% / 12) calc(100% / 12);
    box-shadow: inset 0 0 0 1px rgb(20 33 61 / 0.08);
  }
  .tapete-regla {
    position: absolute;
    display: grid;
    font: 600 0.625rem/1 var(--font-sans);
    color: rgb(20 33 61 / 0.66);
    font-variant-numeric: tabular-nums;
  }
  .tapete-regla span {
    display: grid;
    place-items: center;
  }
  .tapete-regla-x {
    left: 0;
    right: 0;
    top: -1.25rem;
    grid-template-columns: repeat(12, 1fr);
  }
  .tapete-regla-y {
    top: 0;
    bottom: 0;
    left: -1.25rem;
    grid-template-rows: repeat(12, 1fr);
  }
  .portada-mesa :global(.portada-mesa-piezas) {
    color: var(--color-medianoche);
  }
  .portada-pista {
    font-size: 0.8125rem;
    color: color-mix(in oklab, var(--color-tinta) 60%, transparent);
  }
  @media (hover: none), (prefers-reduced-motion: reduce) {
    .portada-pista {
      visibility: hidden;
    }
  }

  /* ---------- Marquesina ---------- */
  .marquesina {
    overflow: hidden;
    background: var(--color-maiz);
    color: var(--color-tinta);
    padding-block: 1.1rem;
    border-block: 1px solid rgb(14 20 36 / 0.12);
  }
  .marquesina-pista {
    display: flex;
    width: max-content;
  }
  .marquesina-lista {
    display: flex;
    flex: none;
    gap: 2.5rem;
    padding-right: 2.5rem;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.125rem, 1rem + 0.8vw, 1.625rem);
    letter-spacing: -0.02em;
    white-space: nowrap;
  }
  .marquesina-lista li {
    display: flex;
    align-items: center;
    gap: 2.5rem;
  }
  .marquesina-pieza {
    width: 0.9em;
    height: 0.9em;
    background: var(--color-medianoche);
  }
  .pieza-0 {
    border-radius: 100% 0 0 0;
  }
  .pieza-1 {
    clip-path: polygon(0 0, 100% 0, 0 100%);
  }
  .pieza-2 {
    border-radius: 0 0 0 100%;
  }
  @media (prefers-reduced-motion: no-preference) {
    .marquesina-pista {
      animation: marquesina 38s linear infinite;
    }
    .marquesina:hover .marquesina-pista {
      animation-play-state: paused;
    }
  }
  @keyframes marquesina {
    to {
      transform: translateX(-50%);
    }
  }

  /* ---------- Recorrido ---------- */
  .recorrido {
    background: var(--color-medianoche);
    --foco: var(--color-maiz);
    color: var(--color-papel);
    padding-block: clamp(4.5rem, 10vw, 8rem);
  }
  .recorrido-cabecera {
    display: grid;
    gap: 1.25rem;
    margin-bottom: clamp(2rem, 6vw, 4rem);
  }
  .recorrido .titulo-grande {
    color: var(--color-papel);
  }
  .recorrido-cabecera p {
    max-width: 56ch;
    font-size: 1.125rem;
    line-height: 1.6;
    color: color-mix(in oklab, var(--color-papel) 78%, transparent);
  }
  @media (min-width: 1024px) {
    .recorrido-cabecera {
      grid-template-columns: 7fr 5fr;
      align-items: end;
      gap: 3rem;
    }
  }
  .recorrido-reticula {
    display: grid;
  }
  .recorrido-mesa {
    position: sticky;
    top: 4rem;
    z-index: 2;
    background: var(--color-medianoche);
    padding-block: 0.75rem;
  }
  .recorrido-mesa-pegada {
    width: min(100%, 42svh, 34rem);
    margin-inline: auto;
  }
  .recorrido-marcas {
    display: flex;
    justify-content: center;
    gap: 0.375rem;
    margin-top: 0.75rem;
  }
  .recorrido-marcas li {
    width: 1.75rem;
    height: 0.3rem;
    border-radius: 999px;
    background: rgb(245 245 240 / 0.2);
    transition: background-color 300ms, width 400ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  .recorrido-marcas li[data-activo] {
    width: 3rem;
    background: var(--color-maiz);
  }
  /* En celular la mesa queda pegada arriba: que no tape el enlace con foco. */
  @media (max-width: 1023px) {
    .recorrido-pasos :is(a, button) {
      scroll-margin-top: calc(42svh + 8rem);
    }
  }
  .recorrido-marcas span {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
  }
  .recorrido-pasos {
    position: relative;
  }
  .paso {
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    gap: 1rem;
    min-height: 58svh;
    padding-block: 2.5rem;
    border-top: 1px solid rgb(245 245 240 / 0.12);
  }
  .paso:last-child {
    min-height: 50svh;
  }
  /* El paso que no está activo se apaga cambiando de color (no con opacidad), para que siga
     pasando contraste AA. */
  .paso-titulo,
  .paso-texto,
  .paso .enlace-claro {
    transition: color 400ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  :global(.vivo) .paso:not([data-activo]) .paso-titulo {
    color: rgb(245 245 240 / 0.52);
  }
  :global(.vivo) .paso:not([data-activo]) .paso-texto,
  :global(.vivo) .paso:not([data-activo]) .enlace-claro {
    color: rgb(245 245 240 / 0.58);
  }
  .paso-numero {
    font: 700 0.875rem/1 var(--font-sans);
    color: var(--color-maiz);
    font-variant-numeric: tabular-nums;
  }
  .paso-titulo {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(2rem, 1.4rem + 3vw, 3.75rem);
    line-height: 1;
    letter-spacing: -0.04em;
    color: var(--color-papel);
  }
  .paso-texto {
    max-width: 44ch;
    font-size: 1.125rem;
    line-height: 1.6;
    color: color-mix(in oklab, var(--color-papel) 82%, transparent);
    text-wrap: pretty;
  }
  .paso-pie {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.25rem;
  }
  .paso-etiqueta {
    display: inline-flex;
    align-items: center;
    min-height: 2rem;
    padding: 0.25rem 0.875rem;
    border-radius: 999px;
    border: 1px solid rgb(252 201 49 / 0.6);
    color: var(--color-maiz);
    font-size: 0.875rem;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }
  @media (min-width: 1024px) {
    .recorrido-reticula {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      gap: 1.5rem;
    }
    .recorrido-mesa {
      grid-column: 1 / span 6;
      top: 4rem;
      height: calc(100svh - 4rem);
      display: grid;
      align-content: center;
    }
    .recorrido-mesa-pegada {
      width: min(100%, 66svh);
    }
    .recorrido-pasos {
      grid-column: 8 / span 5;
    }
    .paso {
      min-height: 78svh;
      justify-content: center;
      border-top: 0;
    }
    .paso:first-child {
      margin-top: 8svh;
    }
    .paso:last-child {
      min-height: calc(100svh - 4rem);
    }
  }

  /* ---------- Portafolio ---------- */
  .portafolio {
    padding-block: clamp(4.5rem, 10vw, 8rem);
  }
  .demos {
    display: grid;
    gap: clamp(4rem, 10vw, 7rem);
  }
  .demo {
    display: grid;
    gap: 2.5rem;
    align-items: center;
  }
  @media (min-width: 900px) {
    .demo {
      grid-template-columns: 1fr 1fr;
      gap: 4rem;
    }
    .demo-invertida .demo-escena {
      order: 2;
    }
  }
  .demo-escena {
    position: relative;
    display: grid;
    place-items: center;
    aspect-ratio: 1;
    max-width: 34rem;
    width: 100%;
    justify-self: center;
  }
  .demo-forma {
    position: absolute;
    inset: 6%;
  }
  .forma-cuarto {
    background: var(--color-maiz);
    border-radius: 100% 0 0 0;
  }
  .forma-triangulo {
    background: var(--color-medianoche);
    clip-path: polygon(0 0, 100% 0, 0 100%);
  }
  .forma-circulo {
    background: var(--color-gris);
    border-radius: 50%;
  }
  .demo-celular {
    position: relative;
    width: 52%;
    border-radius: 1.75rem;
    padding: 0.5rem;
    background: var(--color-tinta);
    box-shadow: 0 1px 0 rgb(255 255 255 / 0.1) inset, 0 30px 60px -20px rgb(14 20 36 / 0.45);
    transform: rotate(-4deg);
    transition: transform 500ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  .demo-invertida .demo-celular {
    transform: rotate(4deg);
  }
  .demo-celular :global(img) {
    border-radius: 1.3rem;
  }
  .demo-escena:hover .demo-celular {
    transform: rotate(0deg) translateY(-6px);
  }
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .demo-forma {
        animation: forma-gira linear both;
        animation-timeline: view();
        animation-range: entry 0% exit 100%;
      }
    }
  }
  @keyframes forma-gira {
    from {
      transform: rotate(-14deg) scale(0.9);
    }
    to {
      transform: rotate(10deg) scale(1.02);
    }
  }
  .demo-cuerpo {
    display: grid;
    gap: 1rem;
    justify-items: start;
  }
  .demo-plan {
    display: flex;
    gap: 0.75rem;
    align-items: center;
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--color-medianoche);
  }
  .demo-precio {
    padding: 0.2rem 0.65rem;
    border-radius: 999px;
    background: var(--color-medianoche);
    color: var(--color-papel);
    font-variant-numeric: tabular-nums;
  }
  .demo-nombre {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(2.25rem, 1.6rem + 3vw, 3.75rem);
    line-height: 1;
    letter-spacing: -0.04em;
    color: var(--color-medianoche);
  }
  .demo-sector {
    font-weight: 600;
    color: color-mix(in oklab, var(--color-tinta) 70%, transparent);
  }
  .demo-resumen {
    max-width: 42ch;
    font-size: 1.125rem;
    line-height: 1.55;
  }
  .demo-acciones {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.5rem;
    margin-top: 0.5rem;
  }

  .kit {
    display: grid;
    gap: 2rem;
    margin-top: clamp(4rem, 10vw, 7rem);
    padding: clamp(1.5rem, 4vw, 3.5rem);
    border-radius: 1.5rem;
    background: var(--color-medianoche);
    --foco: var(--color-maiz);
    color: color-mix(in oklab, var(--color-papel) 85%, transparent);
  }
  @media (min-width: 900px) {
    .kit {
      grid-template-columns: 7fr 5fr;
      align-items: center;
      gap: 3.5rem;
    }
  }
  .kit-lamina {
    display: grid;
    min-width: 0;
    grid-template-columns: minmax(0, 3fr) minmax(0, 2fr);
    grid-template-rows: auto auto;
    gap: 0.75rem;
  }
  .kit-hueso,
  .kit-carbon {
    min-width: 0;
    display: grid;
    place-items: center;
    border-radius: 1rem;
    padding: 1.5rem;
    aspect-ratio: 4 / 3;
  }
  .kit-hueso {
    background: #EDE6DA;
  }
  .kit-carbon {
    background: #141210;
  }
  .kit-hueso img,
  .kit-carbon img {
    width: 100%;
    max-width: 100%;
    height: auto;
    max-height: 100%;
  }
  .kit-colores {
    grid-column: 1 / -1;
    display: flex;
    height: 2.75rem;
    border-radius: 0.75rem;
    overflow: hidden;
  }
  .kit-colores span {
    flex: 1;
  }
  .kit-cuerpo {
    display: grid;
    gap: 1rem;
    justify-items: start;
  }
  .kit-etiqueta {
    font-weight: 700;
    color: var(--color-maiz);
  }
  .kit-titulo {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(1.75rem, 1.4rem + 1.6vw, 2.5rem);
    line-height: 1.05;
    letter-spacing: -0.03em;
    color: var(--color-papel);
  }
  .kit-precio {
    font-weight: 600;
    color: var(--color-papel);
  }
  .aviso {
    margin-top: 1.5rem;
    font-size: 0.875rem;
    color: color-mix(in oklab, var(--color-tinta) 62%, transparent);
  }

  /* ---------- Precios ---------- */
  .precios {
    background: var(--color-papel-2);
    padding-block: clamp(4.5rem, 10vw, 8rem);
  }
  .fichas {
    display: grid;
    gap: 1.25rem;
  }
  @media (min-width: 1024px) {
    .fichas {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      align-items: start;
    }
  }
  .ficha {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 2rem 1.75rem;
    border-radius: 1.5rem;
    background: var(--color-papel);
    border: 1px solid rgb(20 33 61 / 0.1);
  }
  .ficha-destacada {
    background: var(--color-medianoche);
    --foco: var(--color-maiz);
    color: color-mix(in oklab, var(--color-papel) 85%, transparent);
    border-color: transparent;
  }
  @media (min-width: 1024px) {
    .ficha-destacada {
      transform: translateY(-1.5rem);
    }
  }
  .ficha-sello {
    position: absolute;
    top: 1.5rem;
    right: 1.5rem;
    padding: 0.3rem 0.75rem;
    border-radius: 999px;
    background: var(--color-maiz);
    color: var(--color-tinta);
    font-size: 0.8125rem;
    font-weight: 700;
  }
  .ficha-piezas {
    margin-bottom: 1rem;
  }
  .ficha-piezas .lleno {
    fill: var(--color-medianoche);
  }
  .ficha-piezas .acento {
    fill: var(--color-maiz);
  }
  .ficha-piezas .vacio {
    fill: none;
    stroke: rgb(20 33 61 / 0.35);
    stroke-width: 2;
    stroke-dasharray: 5 5;
  }
  .ficha-destacada .ficha-piezas .lleno {
    fill: var(--color-papel);
  }
  .ficha-destacada .ficha-piezas .vacio {
    stroke: rgb(245 245 240 / 0.45);
  }
  .ficha-destacada .ficha-piezas .acento {
    fill: var(--color-maiz);
  }
  .ficha-nombre {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 2rem;
    letter-spacing: -0.035em;
    line-height: 1;
    color: var(--color-medianoche);
  }
  .ficha-destacada .ficha-nombre,
  .ficha-destacada .ficha-precio {
    color: var(--color-papel);
  }
  .ficha-resumen {
    min-height: 3em;
    line-height: 1.5;
  }
  .ficha-precio {
    margin-top: 1rem;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(2.5rem, 2rem + 2vw, 3.25rem);
    letter-spacing: -0.04em;
    line-height: 1;
    color: var(--color-medianoche);
    font-variant-numeric: tabular-nums;
  }
  .ficha-signo {
    font-size: 0.55em;
    vertical-align: 0.6em;
    margin-right: 0.05em;
  }
  .ficha-unico {
    font-size: 0.875rem;
    color: color-mix(in oklab, currentColor 80%, transparent);
  }
  .ficha-mensual {
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }
  .ficha-lista {
    display: grid;
    gap: 0.5rem;
    margin-block: 1.25rem 1.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid rgb(20 33 61 / 0.12);
    font-size: 0.9375rem;
  }
  .ficha-destacada .ficha-lista {
    border-color: rgb(245 245 240 / 0.15);
  }
  .ficha-lista li {
    display: flex;
    gap: 0.625rem;
    align-items: baseline;
  }
  .ficha-lista li::before {
    content: '';
    flex: none;
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 100% 0 0 0;
    background: var(--color-maiz);
  }
  .ficha-acciones {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.25rem;
    margin-top: auto;
  }
  .ficha-destacada .enlace {
    color: var(--color-papel);
  }

  .mensuales {
    display: grid;
    gap: 1.5rem;
    margin-top: 3.5rem;
    padding-top: 2.5rem;
    border-top: 1px solid rgb(20 33 61 / 0.15);
  }
  @media (min-width: 900px) {
    .mensuales {
      grid-template-columns: 4fr 4fr 4fr;
      gap: 2.5rem;
    }
  }
  .mensuales-texto p,
  .mensual-texto {
    margin-top: 0.5rem;
    line-height: 1.55;
  }
  .mensual-nombre {
    font-weight: 700;
    color: var(--color-medianoche);
  }
  .mensual-precio {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 2rem;
    letter-spacing: -0.03em;
    color: var(--color-medianoche);
    font-variant-numeric: tabular-nums;
  }
  .mensual-precio span {
    font-family: var(--font-sans);
    font-size: 0.9375rem;
    font-weight: 500;
    letter-spacing: 0;
  }
  .extras {
    display: grid;
    gap: 2rem;
    margin-top: 3rem;
  }
  @media (min-width: 900px) {
    .extras {
      grid-template-columns: 1fr 1fr;
      gap: 2.5rem;
    }
  }
  .extras > div {
    display: grid;
    gap: 0.75rem;
    justify-items: start;
    padding: 1.75rem;
    border-radius: 1.25rem;
    border: 1.5px dashed rgb(20 33 61 / 0.25);
    line-height: 1.55;
  }

  /* ---------- Proceso ---------- */
  .proceso {
    background: var(--color-medianoche);
    --foco: var(--color-maiz);
    color: var(--color-papel);
    padding-block: clamp(4.5rem, 10vw, 8rem);
    view-timeline: --proceso block;
  }
  .proceso .titulo-grande {
    color: var(--color-papel);
  }
  .proceso-pista {
    position: relative;
    margin-bottom: 3rem;
  }
  .proceso-linea {
    position: absolute;
    left: 1.25rem;
    top: 0;
    bottom: 0;
    width: 2px;
    background: rgb(245 245 240 / 0.18);
  }
  .proceso-rueda {
    position: absolute;
    left: 50%;
    top: 0;
    width: 2.5rem;
    height: 2.5rem;
    margin-left: -1.25rem;
    background: var(--color-maiz);
    border-radius: 100% 0 0 0;
  }
  .proceso-pasos {
    display: grid;
    gap: 2.5rem;
    padding-left: 4rem;
  }
  .proceso-paso h3 {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.5rem;
    letter-spacing: -0.02em;
    color: var(--color-papel);
    margin-block: 0.5rem;
  }
  .proceso-paso p {
    line-height: 1.55;
    color: color-mix(in oklab, var(--color-papel) 78%, transparent);
    max-width: 36ch;
  }
  .proceso-numero {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 3.5rem;
