---
import Base from '../layouts/Base.astro';
import Encabezado from '../components/Encabezado.astro';
import Portada from '../components/Portada.astro';
import Pie from '../components/Pie.astro';
import BotonWhatsApp from '../components/BotonWhatsApp.astro';
import site from '../data/site.json';
import { enlaceWhatsApp } from '../lib/rutas';
import Imagen from '../base/Imagen.astro';

const demos = site.demos.lista.map((d) => ({ d, plan: site.paquetes.find((p) => p.slug === d.plan)! }));
const kitPrecio = site.detallePlanes.extras.find((e) => e.nombre.startsWith('Kit de marca'))!.precio;
const s = site.servicios;
const k = site.portafolio.kit;
const kitColores = site.kitMuestra.colores;
const cta = site.ctaSecciones;

const wa = enlaceWhatsApp(site.whatsapp, site.whatsappTexto);
const ig = `https://www.instagram.com/${site.instagram}/`;
const waEspecial = enlaceWhatsApp(site.whatsapp, site.especiales.whatsappTexto);
---

<Base>
  <Encabezado />

  <main id="inicio">
    <Portada />

    <!-- Lo que hacemos -->
    <section id="servicios" class="py-16 sm:py-24" aria-labelledby="servicios-titulo">
      <div class="contenedor">
        <div class="grid gap-4 lg:grid-cols-12">
          <h2 id="servicios-titulo" class="titulo-seccion lg:col-span-5">{s.titulo}</h2>
          <p class="max-w-xl text-tinta/75 lg:col-span-6 lg:col-start-7 lg:self-end">{s.intro}</p>
        </div>

        <ul class="mt-12 border-b border-azul/15">
          <li class="servicio">
            <h3 class="servicio-nombre">{s.web.nombre}</h3>
            <p class="servicio-texto">{s.web.texto}</p>
            <div class="servicio-cierre">
              <p class="servicio-precio">{s.web.precio}</p>
              <a href="#precios" class="enlace">{s.web.enlace}</a>
            </div>
          </li>
          <li class="servicio">
            <h3 class="servicio-nombre">{s.kit.nombre}</h3>
            <p class="servicio-texto">{s.kit.texto}</p>
            <div class="servicio-cierre">
              <p class="servicio-precio">{kitPrecio}</p>
              <a href="portafolio/kit-de-marca/" class="enlace">{s.kit.enlace}</a>
            </div>
          </li>
          <li id="especiales" class="servicio">
            <h3 class="servicio-nombre">{site.especiales.titulo}</h3>
            <div class="servicio-texto">
              <p>{site.especiales.texto}</p>
              <ul class="mt-4 flex flex-wrap gap-2">
                {site.especiales.ejemplos.map((e) => (
                  <li class="rounded-md border border-azul/20 px-2.5 py-1 text-sm text-azul">{e}</li>
                ))}
              </ul>
            </div>
            <div class="servicio-cierre">
              <a href={waEspecial} class="boton-azul" target="_blank" rel="noopener">{site.especiales.boton}</a>
            </div>
          </li>
        </ul>
      </div>
    </section>

    <!-- Beneficios y sectores -->
    <section class="bg-crema-2 py-16 sm:py-24" aria-labelledby="beneficios-titulo">
      <div class="contenedor grid gap-10 lg:grid-cols-12">
        <div class="lg:col-span-5">
          <div class="lg:sticky lg:top-28">
            <h2 id="beneficios-titulo" class="titulo-seccion">{site.beneficiosTitulo}</h2>
            <a href={enlaceWhatsApp(site.whatsapp, cta.beneficios.whatsappTexto)} class="boton-azul mt-8" target="_blank" rel="noopener">{cta.beneficios.boton}</a>
          </div>
        </div>
        <div class="lg:col-span-6 lg:col-start-7">
          <dl class="divide-y divide-azul/15 border-y border-azul/15">
            {site.beneficios.map((b) => (
              <div class="py-7">
                <dt class="font-display text-xl font-semibold text-azul sm:text-2xl">{b.titulo}</dt>
                <dd class="mt-2 text-tinta/75 [text-wrap:pretty]">{b.texto}</dd>
              </div>
            ))}
          </dl>

          <h3 class="mt-14 font-display text-lg font-semibold text-azul">{site.sectoresTitulo}</h3>
          <dl class="mt-5 grid gap-6 sm:grid-cols-3 sm:gap-5">
            {site.sectores.map((x) => (
              <div class="border-t-2 border-azul pt-4">
                <dt class="font-semibold text-azul">{x.titulo}</dt>
                <dd class="mt-1.5 text-sm text-tinta/75">{x.texto}</dd>
              </div>
            ))}
          </dl>
        </div>
      </div>
    </section>

    <!-- Portafolio -->
    <section id="portafolio" class="portafolio bg-azul py-16 text-crema sm:py-24" aria-labelledby="portafolio-titulo">
      <div class="contenedor">
        <div class="grid gap-4 lg:grid-cols-12">
          <h2 id="portafolio-titulo" class="titulo-seccion text-crema lg:col-span-6">{site.portafolio.titulo}</h2>
          <p class="max-w-xl text-crema/75 lg:col-span-6 lg:self-end">{site.portafolio.intro}</p>
        </div>

        <div class="mt-12 grid gap-12 md:grid-cols-3 md:gap-6">
          {demos.map(({ d, plan }) => (
            <article class="demo flex flex-col">
              <a href={`demos/${d.slug}/`} class="demo-marco" tabindex="-1" aria-hidden="true">
                <Imagen
                  ruta={`portafolio/${d.slug}`}
                  alt=""
                  anchos={[320, 480]}
                  sizes="(min-width: 768px) 190px, 55vw"
                  proporcion="390/700"
                  claseMarco="demo-captura"
                  class="block w-full"
                />
              </a>
              <p class="mt-6 text-sm text-crema/70 [font-variant-numeric:tabular-nums]">Plan {plan.nombre} · ${plan.precio}</p>
              <h3 class="mt-1 text-2xl font-semibold text-crema">{d.nombre}</h3>
              <p class="text-sm text-crema/70">{d.sector}</p>
              <p class="mt-4 text-crema/80">{d.resumen}</p>
              <p class="mt-5 text-sm font-semibold text-crema">{site.portafolio.muestra}</p>
              <ul class="mt-2 space-y-1.5 text-sm text-crema/80">
                {d.muestra.map((m) => (
                  <li class="flex gap-2"><span aria-hidden="true" class="text-celeste">✓</span><span>{m}</span></li>
                ))}
              </ul>
              <div class="mt-auto flex flex-col gap-3 pt-7">
                <a href={`demos/${d.slug}/`} class="boton-claro">{site.portafolio.verDemo}</a>
                <a href={`planes/${plan.slug}/`} class="text-center text-sm font-semibold text-crema underline underline-offset-4 hover:text-celeste">{site.portafolio.verPlan}</a>
              </div>
            </article>
          ))}
        </div>

        <!-- Kit de marca de muestra -->
        <article class="kit mt-16 grid overflow-hidden rounded-2xl bg-crema text-tinta lg:grid-cols-2" aria-labelledby="kit-titulo">
          <div class="flex flex-col p-7 sm:p-10">
            <p class="text-sm font-semibold text-azul">{k.etiqueta}</p>
            <h3 id="kit-titulo" class="mt-2 text-3xl font-semibold sm:text-4xl">{k.titulo}</h3>
            <p class="mt-4 max-w-md text-tinta/75 [text-wrap:pretty]">{k.texto}</p>
            <p class="mt-5 text-sm font-semibold text-azul [font-variant-numeric:tabular-nums]">{k.precio.replace('{precio}', kitPrecio)}</p>
            <div class="mt-8 lg:mt-auto lg:pt-8">
              <a href="portafolio/kit-de-marca/" class="boton-azul">{k.ver}</a>
            </div>
          </div>
          <a href="portafolio/kit-de-marca/" class="kit-lamina" tabindex="-1" aria-hidden="true">
            <span class="kit-hueso">
              <img src="portafolio/kit-filo/filo-horizontal-color.svg" alt="" width="1129" height="335" loading="lazy" class="w-[78%]" />
            </span>
            <span class="kit-carbon">
              <img src="portafolio/kit-filo/filo-compacto-color-oscuro.svg" alt="" width="676" height="440" loading="lazy" class="w-[72%]" />
            </span>
            <span class="kit-icono">
              <img src="portafolio/kit-filo/filo-icono-color.svg" alt="" width="485" height="485" loading="lazy" class="w-[64%]" />
            </span>
            <span class="kit-colores">
              {kitColores.map((c) => <span style={`background:${c.hex}`}></span>)}
            </span>
          </a>
        </article>

        <p class="mt-6 text-sm text-crema/60">{site.portafolio.aviso}</p>
      </div>
    </section>

    <!-- Precios -->
    <section id="precios" class="bg-crema-2 py-16 sm:py-24">
      <div class="contenedor">
        <h2 class="titulo-seccion">{site.precios.titulo}</h2>
        <p class="mt-3 max-w-2xl text-tinta/75">{site.precios.intro}</p>

        <div class="mt-10 grid gap-5 lg:grid-cols-3">
          {site.paquetes.map((p) => (
            <article class:list={[
              'flex flex-col rounded-2xl p-7',
              p.destacado ? 'border border-transparent bg-azul text-crema ring-2 ring-celeste' : 'border border-azul/10 bg-crema',
            ]}>
              <div class="flex items-center justify-between">
                <h3 class:list={['text-2xl font-semibold', p.destacado && 'text-crema']}>{p.nombre}</h3>
                {p.destacado && <span class="rounded-full bg-celeste px-3 py-1 text-xs font-semibold text-azul">Más elegido</span>}
              </div>
              <p class:list={['mt-2 text-sm', p.destacado ? 'text-crema/75' : 'text-tinta/70']}>{p.resumen}</p>
              <p class="mt-6 [font-variant-numeric:tabular-nums]">
                <span class="font-display text-4xl font-semibold tracking-tight">${p.precio}</span>
                <span class:list={['ml-1 text-sm', p.destacado ? 'text-crema/70' : 'text-tinta/60']}>COP</span>
              </p>
              <p class:list={['text-sm [font-variant-numeric:tabular-nums]', p.destacado ? 'text-crema/75' : 'text-tinta/70']}>+ ${p.mensual} al mes</p>
              <ul class="mt-6 space-y-2 text-sm">
                {p.incluye.map((item) => (
                  <li class="flex gap-2">
                    <span aria-hidden="true" class:list={[p.destacado ? 'text-celeste' : 'text-azul']}>✓</span>
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
              <div class="mt-auto flex flex-col gap-3 pt-8">
                <a href={enlaceWhatsApp(site.whatsapp, site.detallePlanes.whatsappPlan.replace('{plan}', p.nombre))} target="_blank" rel="noopener" class:list={[p.destacado ? 'boton-claro' : 'boton-azul']}>Quiero {p.nombre}</a>
                <a href={`planes/${p.slug}/`} class:list={['text-center text-sm font-semibold underline underline-offset-4', p.destacado ? 'text-crema hover:text-celeste' : 'text-azul hover:text-azul-2']}>{site.detallePlanes.verDetalle}</a>
              </div>
            </article>
          ))}
        </div>

        <div class="mt-10 grid gap-5 md:grid-cols-2">
          {site.planes.map((pl) => (
            <div class="rounded-2xl border border-azul/10 bg-crema p-6">
              <p class="font-display text-lg font-semibold text-azul [font-variant-numeric:tabular-nums]">Plan {pl.nombre} · ${pl.precio} al mes</p>
              <p class="mt-2 text-sm text-tinta/75">{pl.texto}</p>
            </div>
          ))}
        </div>

        <p class="mt-8 text-center">
          <a href="planes/" class="boton-azul">{site.detallePlanes.comparar}</a>
        </p>
      </div>
    </section>

    <!-- Proceso -->
    <section id="proceso" class="bg-azul py-16 text-crema sm:py-24" aria-labelledby="proceso-titulo">
      <div class="contenedor">
        <div class="flex flex-col items-start justify-between gap-6 md:flex-row md:items-end">
          <h2 id="proceso-titulo" class="titulo-seccion text-crema">{site.procesoTitulo}</h2>
          <a href={enlaceWhatsApp(site.whatsapp, cta.proceso.whatsappTexto)} class="boton-claro" target="_blank" rel="noopener">{cta.proceso.boton}</a>
        </div>
        <ol class="proceso mt-12">
          {site.proceso.map((paso, i) => (
            <li class="paso">
              <span class="paso-numero" aria-hidden="true">{i + 1}</span>
              <h3 class="text-lg font-semibold text-crema">{paso.titulo}</h3>
              <p class="mt-2 text-sm text-crema/75 [text-wrap:pretty]">{paso.texto}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- Preguntas -->
    <section id="preguntas" class="py-16 sm:py-24">
      <div class="contenedor grid gap-10 lg:grid-cols-12">
        <div class="lg:col-span-4">
          <h2 class="titulo-seccion">Preguntas frecuentes</h2>
          <a href={enlaceWhatsApp(site.whatsapp, cta.preguntas.whatsappTexto)} class="boton-azul mt-8" target="_blank" rel="noopener">{cta.preguntas.boton}</a>
        </div>
        <div class="divide-y divide-azul/10 border-y border-azul/10 lg:col-span-7 lg:col-start-6">
          {site.preguntas.map((q) => (
            <details class="group py-5">
              <summary class="flex min-h-11 cursor-pointer list-none items-center justify-between gap-4 font-display font-semibold text-azul [&::-webkit-details-marker]:hidden">
                {q.p}
                <span class="text-xl text-azul/60 transition-transform duration-200 group-open:rotate-45" aria-hidden="true">+</span>
              </summary>
              <p class="mt-3 text-tinta/75">{q.r}</p>
              {'enlace' in q && (
                <a href={q.enlace.href} class="mt-3 inline-block font-medium text-azul underline underline-offset-4 hover:text-tinta">{q.enlace.texto}</a>
              )}
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- Contacto -->
    <section id="contacto" class="bg-azul text-crema">
      <div class="contenedor flex flex-col items-start gap-6 py-16 sm:py-20 md:flex-row md:items-center md:justify-between">
        <div>
          <h2 class="titulo-seccion text-crema">{site.contacto.titulo}</h2>
          <p class="mt-3 max-w-xl text-crema/80">{site.contacto.texto}</p>
        </div>
        <div class="flex flex-wrap gap-3">
          <a href={wa} class="boton-claro" target="_blank" rel="noopener">{site.contacto.boton}</a>
          <a href={`mailto:${site.correo}`} class="boton-borde">{site.correo}</a>
          <a href={ig} class="boton-borde" target="_blank" rel="noopener">@{site.instagram}</a>
        </div>
      </div>
    </section>
  </main>

  <Pie />

  <BotonWhatsApp />
</Base>

<style>
  .titulo-seccion {
    font-size: clamp(2rem, 1.4rem + 2.6vw, 3.25rem);
    font-weight: 600;
    line-height: 1.06;
    letter-spacing: -0.035em;
    text-wrap: balance;
  }

  /* Lo que hacemos: filas tipográficas, no tarjetas. */
  .servicio {
    display: grid;
    gap: 0.75rem;
    padding-block: 2rem;
    border-top: 1px solid rgb(29 42 58 / 0.15);
  }
  .servicio-nombre {
    font-size: clamp(1.6rem, 1.2rem + 1.6vw, 2.25rem);
    font-weight: 600;
    line-height: 1.1;
    letter-spacing: -0.03em;
  }
  .servicio-texto {
    max-width: 36rem;
    color: rgb(4 5 7 / 0.75);
    text-wrap: pretty;
  }
  .servicio-cierre {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem 1.25rem;
    margin-top: 0.5rem;
  }
  .servicio-precio {
    font-family: var(--font-display);
    font-weight: 600;
    color: var(--color-azul);
    font-variant-numeric: tabular-nums;
  }
  @media (min-width: 1024px) {
    .servicio {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: 1.5rem;
      align-items: start;
      padding-block: 2.5rem;
    }
    .servicio-nombre {
      grid-column: span 5;
    }
    .servicio-texto {
      grid-column: 6 / span 4;
    }
    .servicio-cierre {
      grid-column: 10 / span 3;
      flex-direction: column;
      align-items: flex-end;
      margin-top: 0;
      text-align: right;
    }
  }

  .enlace {
    font-weight: 600;
    color: var(--color-azul);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.3em;
    transition: color 150ms ease;
  }
  .enlace:hover {
    color: var(--color-tinta);
  }

  /* Portafolio */
  .demo-marco {
    position: relative;
    display: grid;
    place-items: end center;
    aspect-ratio: 4 / 3.4;
    overflow: hidden;
    border-radius: 1rem;
    background: var(--color-azul-2);
    box-shadow: inset 0 0 0 1px rgb(253 248 244 / 0.08);
  }
  .demo-marco :global(.demo-captura) {
    display: block;
    width: 54%;
    translate: 0 14%;
    border-radius: 1.4rem 1.4rem 0 0;
    border: 5px solid #0b1119;
    border-bottom: 0;
    overflow: hidden;
    box-shadow: 0 24px 50px -16px rgb(0 0 0 / 0.6);
    transition: translate 300ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  @media (hover: hover) and (pointer: fine) {
    .demo:hover .demo-marco :global(.demo-captura) {
      translate: 0 9%;
    }
  }

  /* Kit de marca: lámina con los colores de Filo. */
  .kit-lamina {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    grid-template-rows: 1fr 1fr auto;
    min-height: 20rem;
  }
  .kit-lamina > span {
    display: grid;
    place-items: center;
    padding: 1.5rem;
  }
  .kit-hueso {
    grid-column: 1 / -1;
    background: #ede6da;
  }
  .kit-carbon {
    background: #141210;
  }
  .kit-icono {
    background: #e4dccd;
  }
  .kit-colores {
    grid-column: 1 / -1;
    grid-template-columns: repeat(4, 1fr);
    place-items: stretch !important;
    padding: 0 !important;
    height: 1.5rem;
  }
  .kit-lamina img {
    transition: transform 300ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  @media (hover: hover) and (pointer: fine) {
    .kit:hover .kit-lamina img {
      transform: scale(1.03);
    }
  }

  /* Proceso: una línea de tiempo, porque sí es una secuencia. */
  .proceso {
    display: grid;
    gap: 2rem;
    position: relative;
  }
  .paso {
    position: relative;
    padding-left: 3.5rem;
  }
  .paso::before {
    content: '';
    position: absolute;
    left: 1.1rem;
    top: 2.6rem;
    bottom: -2rem;
    width: 1px;
    background: rgb(253 248 244 / 0.18);
  }
  .paso:last-child::before {
    display: none;
  }
  .paso-numero {
    position: absolute;
    left: 0;
    top: 0;
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border: 1px solid var(--color-celeste);
    border-radius: 999px;
    font-family: var(--font-display);
    font-weight: 600;
    color: var(--color-celeste);
    font-variant-numeric: tabular-nums;
  }
  @media (min-width: 768px) {
    .proceso {
      grid-template-columns: repeat(5, minmax(0, 1fr));
      gap: 1.5rem;
    }
    .paso {
      padding-left: 0;
      padding-top: 3.75rem;
    }
    .paso::before {
      left: 2.6rem;
      right: -1.5rem;
      top: 1.1rem;
      bottom: auto;
      width: auto;
      height: 1px;
    }
  }
</style>
