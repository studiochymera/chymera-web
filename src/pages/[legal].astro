---
import Base from '../layouts/Base.astro';
import Encabezado from '../components/Encabezado.astro';
import Pie from '../components/Pie.astro';
import BotonWhatsApp from '../components/BotonWhatsApp.astro';
import site from '../data/site.json';

export function getStaticPaths() {
  return site.legal.enlaces.map((e) => ({ params: { legal: e.slug } }));
}

const { legal: slug } = Astro.params;
const pagina = site.legal[slug as 'privacidad' | 'terminos'];
const otras = site.legal.enlaces.filter((e) => e.slug !== slug);
---

<Base titulo={`${pagina.titulo} · ${site.nombre}`} descripcion={pagina.descripcion}>
  <Encabezado />

  <main>
    <section class="bg-azul text-crema">
      <div class="contenedor max-w-3xl py-14 sm:py-20">
        <nav aria-label="Ruta" class="text-sm text-crema/60">
          <a href="../" class="hover:text-crema">Inicio</a>
          <span aria-hidden="true" class="mx-2">/</span>
          <span class="text-crema">{pagina.titulo}</span>
        </nav>
        <h1 class="mt-5 text-3xl font-semibold leading-tight text-crema sm:text-5xl">{pagina.titulo}</h1>
        <p class="mt-4 text-sm text-crema/60">{site.legal.actualizadoTexto}: {site.legal.actualizado}</p>
      </div>
    </section>

    <article class="contenedor max-w-3xl py-14 sm:py-20">
      <p class="text-lg text-tinta/80">{pagina.intro}</p>
      {pagina.secciones.map((sec, i) => (
        <section class="mt-10 border-t border-azul/10 pt-8">
          <h2 class="text-xl font-semibold sm:text-2xl">
            <span class="mr-2 font-display text-azul/50">{i + 1}.</span>{sec.titulo}
          </h2>
          {sec.texto?.map((t) => <p class="mt-3 text-tinta/80">{t}</p>)}
          {sec.lista && (
            <ul class="mt-4 space-y-2 text-tinta/80">
              {sec.lista.map((l) => (
                <li class="flex gap-3"><span aria-hidden="true" class="mt-2.5 h-1.5 w-1.5 shrink-0 rounded-full bg-azul"></span><span>{l}</span></li>
              ))}
            </ul>
          )}
        </section>
      ))}

      <div class="mt-14 flex flex-wrap gap-3 border-t border-azul/10 pt-8">
        {otras.map((o) => <a href={`../${o.slug}/`} class="boton-azul">{o.texto}</a>)}
        <a href="../planes/" class="boton border border-azul/25 text-azul hover:border-azul">{site.detallePlanes.titulo}</a>
      </div>
    </article>
  </main>

  <Pie />

  <BotonWhatsApp />
</Base>
