---
// Base técnica de Chymera: botón flotante de WhatsApp, siempre visible, con el mensaje listo.
// Color y posición se ajustan desde la web con --wa-fondo, --wa-icono, --wa-abajo y --wa-derecha.
import { enlaceWhatsApp } from './formato';

interface Props {
  numero: string; // con indicativo, sin +: 573001234567
  texto: string; // mensaje que aparece escrito en el chat
  etiqueta: string; // texto para lectores de pantalla
  rotulo?: string; // texto visible al lado del icono (opcional)
}

const { numero, texto, etiqueta, rotulo } = Astro.props;
---

<a href={enlaceWhatsApp(numero, texto)} target="_blank" rel="noopener" aria-label={etiqueta} class:list={['wa-flotante', rotulo && 'con-rotulo']}>
  <svg viewBox="0 0 32 32" width="28" height="28" aria-hidden="true"><path fill="currentColor" d="M16 3a13 13 0 0 0-11.2 19.6L3 29l6.6-1.7A13 13 0 1 0 16 3zm0 23.7a10.7 10.7 0 0 1-5.5-1.5l-.4-.2-3.9 1 1-3.8-.2-.4A10.7 10.7 0 1 1 16 26.7zm5.9-8c-.3-.2-1.9-.9-2.2-1s-.5-.2-.7.2-.8 1-1 1.2-.4.2-.7 0a8.8 8.8 0 0 1-4.4-3.8c-.3-.6.3-.5 1-1.7.1-.2 0-.4 0-.6l-1-2.4c-.3-.6-.5-.5-.7-.5h-.6a1.2 1.2 0 0 0-.9.4 3.7 3.7 0 0 0-1.1 2.7 6.4 6.4 0 0 0 1.3 3.4 14.7 14.7 0 0 0 5.6 5c2.1.9 2.9 1 4 .8a3.4 3.4 0 0 0 2.2-1.6 2.8 2.8 0 0 0 .2-1.6c-.1-.1-.3-.2-.6-.3z"/></svg>
  {rotulo && <span>{rotulo}</span>}
</a>

<style>
  .wa-flotante {
    position: fixed;
    z-index: 60;
    right: calc(var(--wa-derecha, 1.25rem) + env(safe-area-inset-right));
    bottom: calc(var(--wa-abajo, 1.25rem) + env(safe-area-inset-bottom));
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    min-width: 3.5rem;
    height: 3.5rem;
    border-radius: 999px;
    background: var(--wa-fondo, #25d366);
    color: var(--wa-icono, #fff);
    box-shadow: 0 8px 24px rgb(0 0 0 / 0.25);
    font-weight: 600;
    text-decoration: none;
    transition: transform 0.15s ease;
  }
  .wa-flotante.con-rotulo {
    padding: 0 1.25rem 0 1rem;
  }
  .wa-flotante:hover {
    transform: translateY(-2px);
  }
  .wa-flotante:focus-visible {
    outline: 3px solid var(--wa-foco, #111);
    outline-offset: 3px;
  }
</style>
