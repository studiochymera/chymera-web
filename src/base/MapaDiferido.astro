---
// Base técnica de Chymera: mapa de Google que carga solo al llegar a su sección,
// para que la página abra rápido. Sin JavaScript queda el enlace para abrir Google Maps.
import { enlaceMapa } from './formato';

interface Props {
  consulta: string; // lo que se buscaría en Google Maps: nombre y dirección, o el barrio
  titulo: string; // título del mapa para lectores de pantalla
  textoAbrir: string; // "Abrir en Google Maps"
  class?: string;
}

const { consulta, titulo, textoAbrir, class: clase } = Astro.props;
const embed = `https://www.google.com/maps?q=${encodeURIComponent(consulta)}&output=embed`;
---

<mapa-diferido data-src={embed} data-titulo={titulo} class:list={['mapa', clase]}>
  <a href={enlaceMapa(consulta)} target="_blank" rel="noopener" class="mapa-abrir">{textoAbrir}</a>
</mapa-diferido>

<script>
  class MapaDiferido extends HTMLElement {
    connectedCallback() {
      const cargar = () => {
        if (this.querySelector('iframe')) return;
        const marco = document.createElement('iframe');
        marco.src = this.dataset.src!;
        marco.title = this.dataset.titulo!;
        marco.loading = 'lazy';
        marco.referrerPolicy = 'no-referrer-when-downgrade';
        marco.setAttribute('allowfullscreen', '');
        this.prepend(marco);
      };
      if (!('IntersectionObserver' in window)) return cargar();
      const vigia = new IntersectionObserver((entradas) => {
        if (entradas.some((e) => e.isIntersecting)) {
          cargar();
          vigia.disconnect();
        }
      }, { rootMargin: '300px' });
      vigia.observe(this);
    }
  }
  customElements.define('mapa-diferido', MapaDiferido);
</script>

<style>
  .mapa {
    position: relative;
    display: block;
    min-height: 18rem;
    overflow: hidden;
    background: color-mix(in srgb, currentColor 8%, transparent);
  }
  .mapa :global(iframe) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }
  .mapa-abrir {
    position: absolute;
    z-index: 1;
    left: 0.75rem;
    bottom: 0.75rem;
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding: 0 1rem;
    border-radius: var(--mapa-radio, 999px);
    background: var(--mapa-boton-fondo, #fff);
    color: var(--mapa-boton-texto, #111);
    font-size: 0.875rem;
    font-weight: 600;
    text-decoration: none;
    box-shadow: 0 4px 14px rgb(0 0 0 / 0.2);
  }
</style>
